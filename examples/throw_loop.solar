struct Node { value: Int, next: &?Node }

fn main() {
	let sentinel = (Node { value: 0, next: null#[Node] })&;
	let root = sentinel;

	thread::spawn(\ {
		loop {
			let head = sentinel;

			for j in 0..100000 {
				head = (Node { value: j, next: head })&;
			}

			root&.atomic_store(head);
		}
	});

	for _ in 0..1000000 {
		try {
			println(1 / 0);
		} catch (e) {}
	}

	black_box(root);
}
