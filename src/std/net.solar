import intrinsics from "@intrinsics";
import linux from "linux.solar";
import(C) {sockaddr_in} from "linux/in.h";
import(C) {sa_family_t} from "sys/socket.h";
import(C) {in_port_t} from "netinet/in.h";

// The C IPv6 address uses a union of byte/word views. Represent its 128 bits
// as bytes because Solar cannot import unions. The remaining fields follow
// the Linux sockaddr_in6 ABI, with C scalar types for the family and port.
struct(repr(C)) SockaddrIn6 {
	family: sa_family_t,
	port: in_port_t,
	flowinfo: Uint32,
	address: [Uint8; 16],
	scope_id: Uint32,
}

enum SocketAddress { V4(sockaddr_in), V6(SockaddrIn6) }

fn network_port(port: Uint) -> in_port_t {
	Uint16(((port & 255u) << 8u) | ((port >> 8u) & 255u))
}

/// A listening TCP socket.
pub struct TcpListener {
	/// Underlying socket descriptor.
	pub fd: FileDesc,
}

/// A connected TCP socket.
pub struct TcpStream {
	/// Underlying socket descriptor.
	pub fd: FileDesc,
}

fn raw_fd(fd: FileDesc) -> Int64 {
	Int64(intrinsics::fd_to_raw(fd))
}

fn socket_create(domain: Int32) -> FileDesc {
	let raw = unsafe {
		intrinsics::syscall(
			Int64(linux::SYS_socket),
			Int64(domain),
			Int64(linux::SOCK_STREAM + linux::SOCK_CLOEXEC),
			Int64(linux::IPPROTO_IP),
		)
	};
	linux::check_syscall(raw, "socket_create failed"&);
	unsafe { intrinsics::fd_from_raw(Int32(raw)) }
}

fn socket_bind#[T](fd: FileDesc, addr: &T) {
	let result = unsafe {
		intrinsics::syscall(
			Int64(linux::SYS_bind),
			raw_fd(fd),
			addr,
			Uint64(intrinsics::size_of#[T]()),
		)
	};
	linux::check_syscall(result, "socket_bind failed"&);
}

fn socket_listen(fd: FileDesc, backlog: Int) {
	let result = unsafe {
		intrinsics::syscall(
			Int64(linux::SYS_listen),
			raw_fd(fd),
			Int64(backlog),
		)
	};
	linux::check_syscall(result, "socket_listen failed"&);
}

fn socket_accept(fd: FileDesc) -> FileDesc {
	loop {
		let raw = unsafe {
			intrinsics::syscall(
				Int64(linux::SYS_accept4),
				raw_fd(fd),
				0u64,
				0u64,
				Int64(linux::SOCK_CLOEXEC),
			)
		};

		if raw >= 0i64 {
			return unsafe { intrinsics::fd_from_raw(Int32(raw)) };
		}

		if raw != 0i64 - Int64(linux::EINTR) {
			linux::check_syscall(raw, "socket_accept failed"&);
		}
	}
}

fn socket_connect#[T](fd: FileDesc, addr: &T) {
	loop {
		let result = unsafe {
			intrinsics::syscall(
				Int64(linux::SYS_connect),
				raw_fd(fd),
				addr,
				Uint64(intrinsics::size_of#[T]()),
			)
		};
		if result == 0i64 || result == 0i64 - Int64(linux::EISCONN) { break; }

		if result != 0i64 - Int64(linux::EINTR) &&
			result != 0i64 - Int64(linux::EALREADY) {
			linux::check_syscall(result, "socket_connect failed"&);
		}
	}
}

fn socket_set_option(fd: FileDesc, level: Int32, name: Int32, value: Int) {
	let optval = Int32(value);
	let result = unsafe {
		intrinsics::syscall(
			Int64(linux::SYS_setsockopt),
			raw_fd(fd),
			Int64(level),
			Int64(name),
			optval&,
			Uint64(intrinsics::size_of#[Int32]()),
		)
	};
	linux::check_syscall(result, "socket_set_option failed"&);
}

fn socket_local_addr#[T](fd: FileDesc, dst: &T) -> Uint {
	let len = Uint32(intrinsics::size_of#[T]());
	let result = unsafe {
		intrinsics::syscall(
			Int64(linux::SYS_getsockname),
			raw_fd(fd),
			dst,
			len&,
		)
	};
	linux::check_syscall(result, "socket_local_addr failed"&);
	Uint(len)
}

fn socket_shutdown(fd: FileDesc, how: Int32) {
	let result = unsafe {
		intrinsics::syscall(Int64(linux::SYS_shutdown), raw_fd(fd), Int64(how))
	};
	linux::check_syscall(result, "socket_shutdown failed"&);
}

/// Is `addr` an IPv6 literal? (Any ':' marks IPv6 — dotted quads have none.)
fn is_ipv6(addr: &[Uint8]) -> Bool {
	let colon = ':';
	addr.contains(colon&)
}

/// Parses a dotted-quad from addr[from..to) into 4 bytes at out[at..at+4).
fn parse_ipv4_range(
	addr: &[Uint8],
	from: Uint,
	to: Uint,
	out: &[Uint8],
	at: Uint,
) {
	let octet = 0u;
	let idx = at;
	let i = from;

	while i < to {
		let c = addr@[i];

		if c == '.' {
			out@[idx] = Uint8(octet);
			idx = idx + 1u;
			octet = 0u;
		} else {
			octet = octet * 10u + Uint(c - '0');
		}

		i = i + 1u;
	}

	out@[idx] = Uint8(octet);
}

/// Parses an IPv4 dotted-quad ("a.b.c.d") into the 4 bytes at out[0..4).
pub fn parse_ipv4(addr: &[Uint8], out: &[Uint8]) {
	parse_ipv4_range(addr, 0u, addr.len(), out, 0u);
}

fn hex_digit(c: Uint8) -> Uint {
	if c >= '0' && c <= '9' {
		Uint(c - '0')
	} else if c >= 'a' { Uint(c - 'a') + 10u } else { Uint(c - 'A') + 10u }
}

/// Parses the colon-separated IPv6 groups in addr[from..to) — hex groups (2
/// bytes each, big-endian) or one trailing dotted-quad (4 bytes) — writing at
/// byte offset `at` in `out`. Empty groups (adjacent to a `::`) are skipped.
/// Returns the offset after the last byte written.
fn parse_groups(addr: &[Uint8], from: Uint, to: Uint, out: &[Uint8], at: Uint) -> Uint {
	let w = at;
	let group_start = from;
	let val = 0u;
	let dot = '.';
	let i = from;

	while i <= to {
		let c = if i == to { ':' } else { addr@[i] }; // treat the end as ':'

		if c == ':' {
			if i > group_start {
				if addr@[group_start..i]&.contains(dot&) {
					parse_ipv4_range(addr, group_start, i, out, w);
					w = w + 4u;
				} else {
					out@[w] = Uint8(val >> 8u);
					out@[w + 1u] = Uint8(val & 255u);
					w = w + 2u;
				}
			}

			val = 0u;
			group_start = i + 1u;
		} else if c != '.' { val = val * 16u + hex_digit(c); }

		i = i + 1u;
	}

	w
}

/// Parses an IPv6 literal into the 16 bytes at out[0..16) (which must be
/// zeroed). Supports the full 8-group form, `::` compression, and an embedded
/// trailing dotted-quad ("::ffff:192.168.1.10"). No zone IDs.
pub fn parse_ipv6(addr: &[Uint8], out: &[Uint8]) {
	let n = addr.len();

	// Locate and parse around the `::` gap, if any.
	let i = 0u;

	while i + 1u < n {
		if addr@[i] == ':' && addr@[i + 1u] == ':' {
			let left = parse_groups(addr, 0u, i, out, 0u);

			// Groups right of the `::` are flush with the end of the address.
			let tail = [0u8; 16u];
			let tail_len = parse_groups(addr, i + 2u, n, tail&, 0u);
			let j = 0u;

			while j < tail_len {
				out@[16u - tail_len + j] = tail[j];
				j = j + 1u;
			}

			return;
		}

		i = i + 1u;
	}

	let full = parse_groups(addr, 0u, n, out, 0u);
}

// Constructs a typed address; the syscall receives its C layout directly.
fn build_sockaddr(addr: &[Uint8], port: Uint) -> SocketAddress {
	if is_ipv6(addr) {
		let sa = unsafe { intrinsics::zeroed#[SockaddrIn6]() };
		sa.family = Uint16(linux::AF_INET6);
		sa.port = network_port(port);
		parse_ipv6(addr, sa.address&);
		SocketAddress::V6(sa)
	} else {
		let sa = unsafe { intrinsics::zeroed#[sockaddr_in]() };
		sa.sin_family = Uint16(linux::AF_INET);
		sa.sin_port = network_port(port);
		let bytes = [0u8; 4u];
		parse_ipv4(addr, bytes&);
		sa.sin_addr.s_addr = intrinsics::u32_from_le(bytes[0u..4u]);
		SocketAddress::V4(sa)
	}
}

fn family_of(addr: &[Uint8]) -> Int32 {
	if is_ipv6(addr) { linux::AF_INET6 } else { linux::AF_INET }
}

/// Creates a TCP socket bound to `addr:port` (port 0 asks the OS for an
/// ephemeral port — read it back with `local_port`) and starts listening.
/// SO_REUSEADDR is set so restarts don't trip over TIME_WAIT.
pub fn listen(addr: &[Uint8], port: Uint, backlog = linux::TCP_LISTEN_BACKLOG) -> TcpListener {
	let fd = socket_create(family_of(addr));
	socket_set_option(fd, linux::SOL_SOCKET, linux::SO_REUSEADDR, 1);
	match build_sockaddr(addr, port) {
		SocketAddress::V4(sa) => socket_bind(fd, sa&),
		SocketAddress::V6(sa) => socket_bind(fd, sa&),
	};
	socket_listen(fd, backlog);
	TcpListener { fd: fd }
}

/// Blocks until a client connects and returns the connection.
pub method accept(self: TcpListener) -> TcpStream {
	TcpStream { fd: socket_accept(self.fd) }
}

/// The port this listener is actually bound to (useful after binding port 0).
pub method local_port(self: TcpListener) -> Uint {
	// Both address layouts begin with the same family and network-order port.
	let sa = unsafe { intrinsics::zeroed#[SockaddrIn6]() };
	socket_local_addr(self.fd, sa&);
	Uint(network_port(Uint(sa.port)))
}

/// Stops accepting now instead of when the collector reclaims the listener.
pub method close(self: TcpListener) {
	self.fd.close();
}

/// Connects to `addr:port` (IPv4 or IPv6 literal) and returns the stream.
pub fn connect(addr: &[Uint8], port: Uint) -> TcpStream {
	let fd = socket_create(family_of(addr));
	match build_sockaddr(addr, port) {
		SocketAddress::V4(sa) => socket_connect(fd, sa&),
		SocketAddress::V6(sa) => socket_connect(fd, sa&),
	};
	TcpStream { fd: fd }
}

/// Reads up to `buf`'s length bytes, returning the count read (0 once the peer
/// has closed its write side). A single read; may return fewer than requested.
pub method read(self: TcpStream, buf: &[Uint8]) -> Uint {
	self.fd.read(buf)
}

/// Reads up to `max_size` bytes into a fresh GC buffer and returns the bytes
/// read. A single read.
pub method read(self: TcpStream, max_size: Uint) -> &[Uint8] {
	self.fd.read(max_size)
}

/// Writes up to `src`'s length bytes, returning the count actually written. A
/// single write; may write fewer than requested.
pub method write_partial(self: TcpStream, src: &[Uint8]) -> Uint {
	self.fd.write_partial(src)
}

/// Writes the entire `src` buffer, looping over partial writes until done.
pub method write(self: TcpStream, src: &[Uint8]) {
	self.fd.write(src);
}

/// Disables (on = true) Nagle's algorithm: small writes go out immediately
/// instead of coalescing while an ack is outstanding.
pub method set_nodelay(self: TcpStream, on: Bool) {
	socket_set_option(
		self.fd,
		linux::IPPROTO_TCP,
		linux::TCP_NODELAY,
		if on { 1 } else { 0 },
	);
}

/// Half-closes the write side: the peer's next read returns 0 (EOF), while this
/// side can keep reading the peer's remaining data.
pub method shutdown_write(self: TcpStream) {
	socket_shutdown(self.fd, linux::SHUT_WR);
}

/// Half-closes the read side.
pub method shutdown_read(self: TcpStream) {
	socket_shutdown(self.fd, linux::SHUT_RD);
}

/// Closes the connection now instead of when the collector reclaims the stream.
pub method close(self: TcpStream) {
	self.fd.close();
}
