import {Option, Result, throw, gc_keepalive, assert, min, max, size_of} from "lib.solar";
import {Mutex} from "sync.solar";
import {Vec} from "vec.solar";
import intrinsics from "@intrinsics";
import linux from "linux.solar";
import file from "file.solar";

import(C) {
	SYS_io_uring_setup,
	SYS_io_uring_enter,
	SYS_mmap,
	SYS_munmap,
	SYS_close,
	SYS_eventfd2,
	SYS_poll,
	SYS_read,
	SYS_write,
	SYS_fcntl,
} from "sys/syscall.h";
import(C) {F_DUPFD_CLOEXEC} from "fcntl.h";
import(C) {PROT_READ, PROT_WRITE, MAP_SHARED} from "sys/mman.h";
import(C) {EFD_CLOEXEC, EFD_NONBLOCK} from "sys/eventfd.h";
import(C) {pollfd, POLLIN} from "poll.h";
import(C) {
	io_uring_params,
	IORING_FEAT_SINGLE_MMAP,
	IORING_FEAT_NODROP,
	IORING_OFF_SQ_RING,
	IORING_OFF_CQ_RING,
	IORING_OFF_SQES,
	IORING_ENTER_GETEVENTS,
	IORING_OP_READ,
	IORING_OP_WRITE,
	IORING_OP_FSYNC,
	IORING_OP_OPENAT,
	IORING_OP_CLOSE,
	IORING_OP_ASYNC_CANCEL,
} from "linux/io_uring.h";

// The 64-byte SQE's I/O view. The UAPI struct contains unions
// and packed fields, which cannot be imported as a Solar type. Unused union
// arms and the final 24 bytes stay zero; SQE128 is never enabled.
struct(repr(C)) Sqe {
	opcode: Uint8,
	flags: Uint8,
	ioprio: Uint16,
	fd: Int32,
	offset: Uint64,
	address: Uint64,
	len: Uint32,
	operation_flags: Uint32,
	token: Uint64,
	reserved: [Uint64; 3],
}

// The standard 16-byte CQE, without the optional flexible CQE32 extension.
struct(repr(C)) Cqe { token: Uint64, result: Int32, flags: Uint32 }
type Completion = (Uint64, Int32);
type Submit = fn(Sqe);
type Completions = fn(Bool) -> Option#[Completion];

fn mapping(fd: Int64, bytes: Uint, offset: Uint64) -> &[Uint8] {
	let address = unsafe {
		intrinsics::syscall(
			Int64(SYS_mmap),
			0u64,
			Uint64(bytes),
			Int64(PROT_READ | PROT_WRITE),
			Int64(MAP_SHARED),
			fd,
			offset,
		)
	};
	linux::check_syscall(address, "io_uring mmap failed"&);
	unsafe {
		let base = intrinsics::transmute_unchecked#[&Uint8](Uint(address));
		intrinsics::transmute_ref#[[Uint8]](base, bytes)
	}
}

fn field#[out T](memory: &[Uint8], offset: Uint32) -> &T {
	unsafe { intrinsics::transmute_ref#[T](memory@[Uint(offset)]&, 0u) }
}

fn enter(fd: Int64, submit: Uint32, wait: Uint32) -> Int64 {
	unsafe {
		intrinsics::syscall(
			Int64(SYS_io_uring_enter),
			fd,
			Uint64(submit),
			Uint64(wait),
			Int64(IORING_ENTER_GETEVENTS),
			0u64,
			0u64,
		)
	}
}

fn release(mappings: &Vec#[&[Uint8]], fd: Int64, wake: Int64) {
	for index in 0u..mappings.len() {
		let memory = mappings.at(index)@;
		unsafe {
			intrinsics::syscall(Int64(SYS_munmap), memory, Uint64(memory.len()));
		}
	}

	// These private descriptors were never registered as GC-managed FileDesc values.
	unsafe { intrinsics::syscall(Int64(SYS_close), fd); }
	if wake >= 0i64 { unsafe { intrinsics::syscall(Int64(SYS_close), wake); } }
}

/// A request yielded to `run`. I/O requests retain their buffers, descriptors,
/// and completion slots. Open retains a NUL-terminated path, flags, mode, and a
/// slot for the newly registered descriptor; positioned I/O includes an offset.
/// Yield reschedules the coroutine without submitting I/O.
pub enum Suspend {
	Yield,
	Open((&[Uint8], Int32, Int32, &Result#[Uint], &Option#[FileDesc])),
	Close((FileDesc, &Result#[Uint])),
	Read((FileDesc, &[Uint8], &Result#[Uint])),
	Write((FileDesc, &[Uint8], &Result#[Uint])),
	ReadAt((FileDesc, &[Uint8], &Result#[Uint], Uint)),
	WriteAt((FileDesc, &[Uint8], &Result#[Uint], Uint)),
	Sync((FileDesc, &Result#[Uint])),
}

type Task = fn() -> Option#[Suspend];

/// A handle for scheduling coroutines on an executor.
pub struct Context { enqueue: fn(Task) }

/// Enqueues a coroutine yielding `Suspend` to run alongside the main coroutine.
/// Its completion value is discarded. An uncaught exception exits `run`.
/// Tasks submitted after the executor has exited are discarded.
pub method spawn#[C](self: &Context, c: C) {
	(self@.enqueue)(\ c.next());
}

/// Returns a coroutine that gives other ready tasks a turn, then completes with
/// (). Await it inside an executor task to yield without submitting I/O.
pub fn yield() { coroutine { yield Suspend::Yield; } }

// Close requests own an unregistered duplicate until the kernel closes it.
type Pending = (Suspend, Task, Int32);

fn io_entry(fd: FileDesc, buf: &[Uint8], offset: Uint64, opcode: Uint8) -> Sqe {
	let (address, length) = unsafe {
		intrinsics::transmute_unchecked#[(Uint64, Uint64)](buf)
	};
	let entry = unsafe { intrinsics::zeroed#[Sqe]() };
	entry.opcode = opcode;
	entry.fd = intrinsics::fd_to_raw(fd);
	entry.offset = offset;
	entry.address = address;
	entry.len = Uint32(min(length, Uint64(linux::INT_MAX)));
	entry
}

fn submit(enqueue: Submit, request: Suspend, token: Uint64, closing: Int32) {
	let entry = match request {
		Suspend::Yield => { return; },
		Suspend::Open(io) => {
			let entry = unsafe { intrinsics::zeroed#[Sqe]() };
			entry.opcode = Uint8(IORING_OP_OPENAT);
			entry.fd = linux::AT_FDCWD;
			entry.address = unsafe {
				intrinsics::transmute_unchecked#[(Uint64, Uint64)](io.0)
			}.0;
			entry.operation_flags = Uint32(io.1);
			entry.len = Uint32(io.2);
			entry
		},
		Suspend::Close(io) => {
			let entry = unsafe { intrinsics::zeroed#[Sqe]() };
			entry.opcode = Uint8(IORING_OP_CLOSE);
			entry.fd = closing;
			entry
		},
		Suspend::Read(io) => io_entry(io.0, io.1, !0u64, Uint8(IORING_OP_READ)),
		Suspend::Write(io) => io_entry(
			io.0,
			io.1,
			!0u64,
			Uint8(IORING_OP_WRITE),
		),
		Suspend::ReadAt(io) => io_entry(
			io.0,
			io.1,
			Uint64(io.3),
			Uint8(IORING_OP_READ),
		),
		Suspend::WriteAt(io) => io_entry(
			io.0,
			io.1,
			Uint64(io.3),
			Uint8(IORING_OP_WRITE),
		),
		Suspend::Sync(io) => {
			let entry = unsafe { intrinsics::zeroed#[Sqe]() };
			entry.opcode = Uint8(IORING_OP_FSYNC);
			entry.fd = intrinsics::fd_to_raw(io.0);
			entry
		},
	};
	entry.token = token;
	enqueue(entry);
}

fn dispatch(
	enqueue: Submit,
	pending: &Vec#[Option#[Pending]],
	context: &Context,
	request: Suspend,
	resume: Task,
) {
	let closing = match request {
		Suspend::Yield => {
			(context@.enqueue)(resume);
			return;
		},
		Suspend::Close(io) => {
			let duplicate = unsafe {
				intrinsics::syscall(
					Int64(SYS_fcntl),
					Int64(intrinsics::fd_to_raw(io.0)),
					Int64(F_DUPFD_CLOEXEC),
					3u64,
				)
			};

			if duplicate < 0i64 {
				finish(io.1, Int32(duplicate), "file_close failed"&);
				(context@.enqueue)(resume);
				return;
			}

			// Keep the open file description alive while replacing the managed fd
			// with its dead-pipe sentinel. The final close runs in the kernel.
			io.0.close();
			Int32(duplicate)
		},
		_ => 0i32 - 1i32,
	};
	let index = 0u;

	while index < pending.len() && pending.at(index)@.is_some() {
		index = index + 1u;
	}

	if index == pending.len() { pending.push(Option#[Pending]::None); }
	// This traced slot owns the buffer, FileDesc, result storage, and task until
	// completion. The kernel ring only retains raw addresses and IDs.
	pending.at(index)@ = Option#[Pending]::Some((request, resume, closing));
	submit(enqueue, request, Uint64(index) + 1u64, closing);
}

fn finish(result: &Result#[Uint], value: Int32, message: &[Uint8]) {
	try {
		linux::check_syscall(Int64(value), message);
		result@ = Result#[Uint]::Ok(Uint(value));
	} catch (exception) {
		result@ = Result#[Uint]::Err(exception);
	}
}

fn poll(
	enqueue: Submit,
	completions: Completions,
	pending: &Vec#[Option#[Pending]],
	context: &Context,
	wait: Bool,
) {
	let completion = completions(wait);
	if completion.is_none() { return; }
	let (token, value) = completion.unwrap();
	let index = Uint(token - 1u64);
	let (request, resume, closing) = pending.at(index)@.unwrap();
	let is_close = match request { Suspend::Close(io) => true, _ => false };

	// Linux releases the fd even when close reports EINTR; never retry it.
	if value == 0i32 - linux::EINTR && !is_close {
		submit(enqueue, request, token, closing);
		return;
	}

	let (result, message) = match request {
		Suspend::Yield => { return; },
		Suspend::Open(io) => (io.3, "file_open failed"&),
		Suspend::Close(io) => (io.1, "file_close failed"&),
		Suspend::Read(io) => (io.2, "file_read failed"&),
		Suspend::Write(io) => (io.2, "file_write_partial failed"&),
		Suspend::ReadAt(io) => (io.2, "file_read_at failed"&),
		Suspend::WriteAt(io) => (io.2, "file_write_at failed"&),
		Suspend::Sync(io) => (io.1, "file_sync failed"&),
	};
	finish(result, value, message);
	pending.at(index)@ = Option#[Pending]::None;
	(context@.enqueue)(resume);
}

fn with_shutdown#[R](execute: fn() -> R, stop: fn()) -> R {
	let result = Option#[R]::None;

	try {
		result = Option#[R]::Some(execute());
	} catch (error) {
		stop();
		throw(error);
	}

	stop();
	result.unwrap()
}

/// Creates the main coroutine with a context, runs it, and returns its completion
/// value. Coroutines yield `Suspend`; I/O is submitted through io_uring.
/// Ready coroutines run on the calling thread while other requests are in flight.
/// By default, finishing the main coroutine discards queued tasks immediately.
/// With wait_for_all = true, run background tasks and any tasks they spawn to
/// completion before returning the main result. An uncaught exception still
/// exits immediately. Once no tasks remain, further submissions are discarded.
/// Outstanding I/O is cancelled and drained before its buffers are released;
/// closes finish and unused opens are released. Those coroutines are never
/// resumed. Requires kernel io_uring support.
pub fn run#[C](create: fn(&Context) -> C, wait_for_all = false) {
	// Shared queue, read cursor, and whether submissions are accepted.
	let ready = Mutex((Vec([]#[Option#[Task]]&), 0u, true));
	let wake = 0i64;
	let pending = Vec([]#[Option#[Pending]]&);
	assert(size_of#[Sqe]() == 64u);
	assert(size_of#[Cqe]() == 16u);
	let params = unsafe { intrinsics::zeroed#[io_uring_params]() };
	let fd = unsafe {
		intrinsics::syscall(Int64(SYS_io_uring_setup), 64u64, params&)
	};
	linux::check_syscall(fd, "io_uring setup failed"&);
	let mappings = Vec([]#[&[Uint8]]&);
	wake = 0i64 - 1i64;

	try {
		if (params.features & Uint32(IORING_FEAT_NODROP)) == 0u32 {
			throw("io_uring requires completion overflow support"&);
		}

		let sq_bytes = Uint(params.sq_off.array) +
			Uint(params.sq_entries) * size_of#[Uint32]();
		let cq_bytes = Uint(params.cq_off.cqes) +
			Uint(params.cq_entries) * size_of#[Cqe]();

		if (params.features & Uint32(IORING_FEAT_SINGLE_MMAP)) != 0u32 {
			mappings&.push(
				mapping(fd, max(sq_bytes, cq_bytes), IORING_OFF_SQ_RING),
			);
		} else {
			mappings&.push(mapping(fd, sq_bytes, IORING_OFF_SQ_RING));
			mappings&.push(mapping(fd, cq_bytes, IORING_OFF_CQ_RING));
		}

		mappings&.push(
			mapping(
				fd,
				Uint(params.sq_entries) * size_of#[Sqe](),
				IORING_OFF_SQES,
			),
		);
		wake = unsafe {
			intrinsics::syscall(
				Int64(SYS_eventfd2),
				0u64,
				Int64(EFD_CLOEXEC | EFD_NONBLOCK),
			)
		};
		linux::check_syscall(wake, "io_uring eventfd failed"&);
	} catch (error) {
		release(mappings&, fd, wake);
		throw(error);
	}

	let sq = mappings&.at(0u)@;
	let cq = mappings&.at(if mappings&.len() == 2u { 0u } else { 1u })@;
	let sq_head = field#[Uint32](sq, params.sq_off.head);
	let sq_tail = field#[Uint32](sq, params.sq_off.tail);
	let sq_mask = field#[Uint32](sq, params.sq_off.ring_mask)@;
	let sq_array = unsafe {
		intrinsics::transmute_ref#[[Uint32]](
			field#[Uint32](sq, params.sq_off.array),
			Uint(params.sq_entries),
		)
	};
	let sqes = unsafe {
		intrinsics::transmute_ref#[[Sqe]](
			mappings&.at(mappings&.len() - 1u)@,
			Uint(params.sq_entries),
		)
	};
	let cq_head = field#[Uint32](cq, params.cq_off.head);
	let cq_tail = field#[Uint32](cq, params.cq_off.tail);
	let cq_mask = field#[Uint32](cq, params.cq_off.ring_mask)@;
	let cqes = unsafe {
		intrinsics::transmute_ref#[[Cqe]](
			field#[Cqe](cq, params.cq_off.cqes),
			Uint(params.cq_entries),
		)
	};
	let completed = Vec([]#[Completion]&);
	let completion_head = 0u;
	let inflight = 0u;
	let reap = \ {
		let cursor = cq_head.atomic_load();
		let tail = cq_tail.atomic_load();

		while cursor != tail {
			let entry = cqes@[Uint(cursor & cq_mask)];

			if entry.token != 0u64 {
				inflight = inflight - 1u;

				// Register newly opened fds before a completion can be discarded.
				// The pending request's result slot is a traced GC root.
				if entry.result >= 0i32 {
					match pending&.at(Uint(entry.token - 1u64))@.unwrap().0 {
						Suspend::Open(io) => {
							io.4@ = Option#[FileDesc]::Some(unsafe {
								intrinsics::fd_from_raw(entry.result)
							});
						},
						_ => (),
					}
				}

				completed&.push((entry.token, entry.result));
			}

			cursor = cursor ++ 1u32;
		}

		// Publish consumption only after copying all entries; loads/stores use
		// the acquire/release atomics shared with the kernel's ring protocol.
		cq_head.atomic_store(cursor);
	};
	let flush = \ {
		loop {
			reap();
			let count = sq_tail.atomic_load() -- sq_head.atomic_load();
			if count == 0u32 { break; }
			let status = enter(fd, count, 0u32);

			if status != 0i64 - Int64(linux::EINTR) &&
				status != 0i64 - Int64(linux::EBUSY) {
				linux::check_syscall(status, "io_uring submit failed"&);
			}
		};
	};
	let enqueue: Submit = \entry: Sqe {
		flush();
		let tail = sq_tail.atomic_load();
		let index = Uint(tail & sq_mask);
		sqes@[index] = entry;
		sq_array@[index] = Uint32(index);
		if entry.token != 0u64 { inflight = inflight + 1u; }
		sq_tail.atomic_store(tail ++ 1u32);
		flush();
	};
	let completions: Completions = \wait: Bool {
		loop {
			reap();

			if completion_head < completed&.len() {
				let value = completed&.at(completion_head)@;
				completion_head = completion_head + 1u;

				if completion_head >= completed&.len() / 2u {
					completed = Vec(
						completed&.as_slice()@[completion_head..completed&.len()]&,
					);
					completion_head = 0u;
				}

				return Option#[Completion]::Some(value);
			}

			if !wait { return Option#[Completion]::None; }
			let fds = [
				pollfd { fd: Int32(fd), events: Int16(POLLIN), revents: 0i16 },
				pollfd { fd: Int32(wake), events: Int16(POLLIN), revents: 0i16 },
			];
			let status = unsafe {
				intrinsics::syscall(Int64(SYS_poll), fds&, 2u64, 0i64 - 1i64)
			};
			if status == 0i64 - Int64(linux::EINTR) { continue; }
			linux::check_syscall(status, "io_uring wait failed"&);

			if fds[1u].revents != 0i16 {
				let notification = 0u64;
				unsafe {
					intrinsics::syscall(
						Int64(SYS_read),
						wake,
						notification&,
						8u64,
					);
				}
				return Option#[Completion]::None;
			}

			let status = enter(fd, 0u32, 0u32);

			if status != 0i64 - Int64(linux::EINTR) {
				linux::check_syscall(status, "io_uring wait failed"&);
			}
		}
	};
	let context = Context {
		enqueue: \task: Task {
			ready&.with_lock(\state {
				if state@.2 {
					state@.0&.push(Option#[Task]::Some(task));
					let notification = 1u64;
					let status = 0i64;

					loop {
						status = unsafe {
							intrinsics::syscall(
								Int64(SYS_write),
								Int64(wake),
								notification&,
								8u64,
							)
						};
						if status != 0i64 - Int64(linux::EINTR) { break; }
					};

					// EAGAIN means a wakeup is already pending on this eventfd.
					if status < 0i64 && status != 0i64 - Int64(linux::EAGAIN) {
						linux::check_syscall(status, "io_uring wake failed"&);
					}
				}
			});
		},
	};
	let stop = \ {
		ready&.with_lock(\state {
			state@.2 = false;
			state@.0 = Vec([]#[Option#[Task]]&);
			state@.1 = 0u;
		});
		flush();

		for index in 0u..pending&.len() {
			if pending&.at(index)@.is_some() {
				// Closing already invalidated the managed handle. Let the private
				// duplicate's close finish rather than cancelling and leaking it.
				let closing = match pending&.at(index)@.unwrap().0 {
					Suspend::Close(io) => true,
					_ => false,
				};
				if closing { continue; }
				let cancel = unsafe { intrinsics::zeroed#[Sqe]() };
				cancel.opcode = Uint8(IORING_OP_ASYNC_CANCEL);
				cancel.address = Uint64(index) + 1u64;
				enqueue(cancel);
			}
		}

		while inflight != 0u {
			reap();

			if inflight != 0u {
				let status = enter(fd, 0u32, 1u32);

				if status != 0i64 - Int64(linux::EINTR) {
					linux::check_syscall(
						status,
						"io_uring cancellation failed"&,
					);
				}
			}
		}

		// An open may win the race against cancellation without its coroutine
		// ever resuming. Release those files while preserving GC handle validity.
		for index in 0u..pending&.len() {
			match pending&.at(index)@ {
				Option#[Pending]::Some(operation) => match operation.0 {
					Suspend::Open(io) => match io.4@ {
						Option#[FileDesc]::Some(opened) => opened.close(),
						Option#[FileDesc]::None => (),
					},
					_ => (),
				},
				Option#[Pending]::None => (),
			}
		}

		release(mappings&, fd, wake);
		gc_keepalive(pending&);
		pending = Vec([]#[Option#[Pending]]&);
	};

	let step = \ {
		poll(enqueue, completions, pending&, context&, false);
		let (next, running) = ready&.with_lock(\state {
			let queue = state@.0&;
			let head = state@.1&;
			let next = Option#[Task]::None;

			if head@ < queue.len() {
				next = queue.at(head@)@;
				queue.at(head@)@ = Option#[Task]::None;
				head@ = head@ + 1u;
			}

			if head@ == queue.len() {
				queue@ = Vec([]#[Option#[Task]]&);
				head@ = 0u;
			} else if head@ >= queue.len() / 2u {
				// Reclaim consumed slots even when new work keeps arriving.
				queue@ = Vec(queue.as_slice()@[head@..queue.len()]&);
				head@ = 0u;
			}

			if next.is_none() {
				let waiting = false;

				for index in 0u..pending&.len() {
					if pending&.at(index)@.is_some() { waiting = true; break; }
				}

				if !waiting {
					// Close submissions atomically with observing an empty executor.
					state@.2 = false;
				}
			}

			(next, state@.2)
		});
		if !running { return false; }

		match next {
			Option#[Task]::Some(task) => {
				match task() {
					Option#[Suspend]::Some(request) => dispatch(
						enqueue,
						pending&,
						context&,
						request,
						task,
					),
					Option#[Suspend]::None => (),
				}
			},
			Option#[Task]::None => poll(
				enqueue,
				completions,
				pending&,
				context&,
				true,
			),
		};
		true
	};

	with_shutdown(
		\ {
			let result = for request in create(context&) {
				let resumed = false;
				dispatch(
					enqueue,
					pending&,
					context&,
					request,
					\ {
						resumed = true;
						Option#[Suspend]::None
					},
				);

				while !resumed {
					step();
				}
			};
			if wait_for_all { while step() {} }
			result
		},
		stop,
	)
}

/// A GC-managed file descriptor with coroutine-based I/O. Constructing one from
/// a FileDesc shares ownership of that descriptor; the public field exposes it
/// for synchronous operations. I/O coroutines yield `Suspend`
/// and rethrow I/O exceptions at the await site.
pub struct AsyncFileDesc(pub FileDesc);

/// Returns a coroutine that opens path through io_uring and completes with an
/// AsyncFileDesc. Opening and errors occur when the coroutine runs.
/// Options and defaults match `file::open`: read/write select access, append
/// writes at EOF, truncate empties the file, create creates it if absent, new
/// with create rejects an existing file, and mode sets new-file permissions.
/// Paths containing NUL bytes assert when the coroutine runs.
pub fn open(
	path: &[Uint8],
	read = true,
	write = true,
	append = false,
	truncate = false,
	new = false,
	create = false,
	mode = linux::DEFFILEMODE,
) {
	coroutine {
		let flags = if read {
			if write { linux::O_RDWR } else { linux::O_RDONLY }
		} else if write {
			linux::O_WRONLY
		} else {
			linux::O_RDONLY
		};
		flags = flags | linux::O_CLOEXEC;
		if create { flags = flags | linux::O_CREAT; }
		if new { flags = flags | linux::O_EXCL; }
		if truncate { flags = flags | linux::O_TRUNC; }
		if append { flags = flags | linux::O_APPEND; }
		let nul_path = file::nul_terminated(path);
		let result = Result#[Uint]::Ok(0u);
		let opened = Option#[FileDesc]::None;
		yield Suspend::Open((nul_path, flags, mode, result&, opened&));
		result.unwrap();
		AsyncFileDesc(opened.unwrap())
	}
}

/// Returns a coroutine that closes the file through io_uring and completes with
/// (). The executor first invalidates the managed handle while retaining a
/// private duplicate for the kernel to close, preserving stale-handle protection.
pub method close(self: AsyncFileDesc) {
	coroutine {
		let result = Result#[Uint]::Ok(0u);
		yield Suspend::Close((self.0, result&));
		result.unwrap();
	}
}

/// Returns a coroutine that reads up to buf's length bytes and completes with
/// the byte count (zero at EOF). A single read; may return fewer bytes.
pub method read(self: AsyncFileDesc, buf: &[Uint8]) {
	coroutine {
		let result = Result#[Uint]::Ok(0u);
		yield Suspend::Read((self.0, buf, result&));
		result.unwrap()
	}
}

/// Returns a coroutine that reads up to max_size bytes into a new GC buffer and
/// completes with a reference to the bytes read. A single read.
pub method read(self: AsyncFileDesc, max_size: Uint) {
	coroutine {
		let buf: [Uint8] = [0u8; max_size];
		let n = await self.read(buf&);
		buf[0u..n]&
	}
}

/// Returns a coroutine that writes up to src's length bytes and completes with
/// the number actually written. A single write; may write fewer bytes.
pub method write_partial(self: AsyncFileDesc, src: &[Uint8]) {
	coroutine {
		let result = Result#[Uint]::Ok(0u);
		yield Suspend::Write((self.0, src, result&));
		result.unwrap()
	}
}

/// Returns a coroutine that writes all of src, looping over partial writes.
/// Completes with ().
pub method write(self: AsyncFileDesc, src: &[Uint8]) {
	coroutine {
		let written = 0u;

		while written < src.len() {
			written = written +
				await self.write_partial(src@[written..src.len()]&);
		}
	}
}

/// Returns a coroutine that reads into buf at an absolute byte offset without
/// moving the file cursor. Completes with the byte count; short reads are allowed.
pub method read_at(self: AsyncFileDesc, buf: &[Uint8], offset: Uint) {
	coroutine {
		// io_uring reserves -1 for the current cursor; pread rejects it.
		if offset == !0u {
			linux::check_syscall(
				0i64 - Int64(linux::EINVAL),
				"file_read_at failed"&,
			);
		}

		let result = Result#[Uint]::Ok(0u);
		yield Suspend::ReadAt((self.0, buf, result&, offset));
		result.unwrap()
	}
}

/// Returns a coroutine that writes from src at an absolute byte offset without
/// moving the file cursor. Completes with the byte count; short writes are allowed.
pub method write_at_partial(self: AsyncFileDesc, src: &[Uint8], offset: Uint) {
	coroutine {
		// io_uring reserves -1 for the current cursor; pwrite rejects it.
		if offset == !0u {
			linux::check_syscall(
				0i64 - Int64(linux::EINVAL),
				"file_write_at failed"&,
			);
		}

		let result = Result#[Uint]::Ok(0u);
		yield Suspend::WriteAt((self.0, src, result&, offset));
		result.unwrap()
	}
}

/// Returns a coroutine that writes all of src at an absolute byte offset,
/// advancing the offset after each partial write. Completes with ().
pub method write_at(self: AsyncFileDesc, src: &[Uint8], offset: Uint) {
	coroutine {
		let written = 0u;

		while written < src.len() {
			written = written +
				await self.write_at_partial(
					src@[written..src.len()]&,
					offset + written,
				);
		}
	}
}

/// Returns a coroutine that flushes the file's data and metadata to stable
/// storage through io_uring. Completes with ().
pub method sync(self: AsyncFileDesc) {
	coroutine {
		let result = Result#[Uint]::Ok(0u);
		yield Suspend::Sync((self.0, result&));
		result.unwrap();
	}
}

/// Acquires an advisory lock synchronously, like FileDesc.lock. This can block
/// the executor thread; block = false returns false when the lock is held.
pub method lock(self: AsyncFileDesc, exclusive = true, block = true) -> Bool {
	self.0.lock(exclusive = exclusive, block = block)
}

/// Releases the file's advisory lock synchronously.
pub method unlock(self: AsyncFileDesc) { self.0.unlock(); }

/// Reads all non-dot directory entries synchronously, like FileDesc.read_entries.
pub method read_entries(self: AsyncFileDesc) -> &[file::DirEntry] {
	self.0.read_entries()
}

/// An owned, awaitable coroutine handle with fixed size for each yield and
/// completion type. Use it to await a recursive coroutine.
pub struct Box#[T, R] { resume: fn() -> CoroutineState#[T, R] }

/// Wraps a coroutine without resuming it.
pub fn Box::#[C](co: C) {
	Box {
		resume: \ {
			co.resume()
		},
	}
}

/// Resumes the wrapped coroutine and returns its yielded or completed value.
pub method resume#[T, R](self: &Box#[T, R]) {
	(self@.resume)()
}
