/// Unicode predicate generated from Rust's character tables.
pub fn is_whitespace(code: Uint32) -> Bool {
	if code < 8192u32 {
		if code < 133u32 {
			if code < 32u32 {
				code >= 9u32 && code <= 13u32
			} else if code > 32u32 {
				false
			} else { true }
		} else if code > 133u32 {
			if code < 5760u32 {
				code == 160u32
			} else if code > 5760u32 {
				false
			} else { true }
		} else { true }
	} else if code > 8202u32 {
		if code < 8287u32 {
			if code < 8239u32 {
				code >= 8232u32 && code <= 8233u32
			} else if code > 8239u32 {
				false
			} else { true }
		} else if code > 8287u32 {
			code == 12288u32
		} else { true }
	} else { true }
}
