/// Nanoseconds per second in Linux timespec fields.
pub const NSEC_PER_SEC = 1000000000u64;

/// Default maximum number of pending connections in a TCP listener's queue.
pub const TCP_LISTEN_BACKLOG = 128;

/// Buffer size in bytes for each getdents64 batch.
pub const GETDENTS_BUFFER_SIZE = 32768u;

/// Solar futex timeout sentinel requesting an indefinite wait.
pub const FUTEX_NO_TIMEOUT = 18446744073709551615u64;

/// Returns the conventional Linux message for a positive errno code.
pub fn error_message(code: Int) -> &[Uint8] {
	if code == Int(EPERM) { return "Operation not permitted"&; }
	if code == Int(ENOENT) { return "No such file or directory"&; }
	if code == Int(ESRCH) { return "No such process"&; }
	if code == Int(EINTR) { return "Interrupted system call"&; }
	if code == Int(EIO) { return "Input/output error"&; }
	if code == Int(ENXIO) { return "No such device or address"&; }
	if code == Int(E2BIG) { return "Argument list too long"&; }
	if code == Int(ENOEXEC) { return "Exec format error"&; }
	if code == Int(EBADF) { return "Bad file descriptor"&; }
	if code == Int(ECHILD) { return "No child processes"&; }
	if code == Int(EAGAIN) { return "Resource temporarily unavailable"&; }
	if code == Int(ENOMEM) { return "Cannot allocate memory"&; }
	if code == Int(EACCES) { return "Permission denied"&; }
	if code == Int(EFAULT) { return "Bad address"&; }
	if code == Int(ENOTBLK) { return "Block device required"&; }
	if code == Int(EBUSY) { return "Device or resource busy"&; }
	if code == Int(EEXIST) { return "File exists"&; }
	if code == Int(EXDEV) { return "Invalid cross-device link"&; }
	if code == Int(ENODEV) { return "No such device"&; }
	if code == Int(ENOTDIR) { return "Not a directory"&; }
	if code == Int(EISDIR) { return "Is a directory"&; }
	if code == Int(EINVAL) { return "Invalid argument"&; }
	if code == Int(ENFILE) { return "Too many open files in system"&; }
	if code == Int(EMFILE) { return "Too many open files"&; }
	if code == Int(ENOTTY) { return "Inappropriate ioctl for device"&; }
	if code == Int(ETXTBSY) { return "Text file busy"&; }
	if code == Int(EFBIG) { return "File too large"&; }
	if code == Int(ENOSPC) { return "No space left on device"&; }
	if code == Int(ESPIPE) { return "Illegal seek"&; }
	if code == Int(EROFS) { return "Read-only file system"&; }
	if code == Int(EMLINK) { return "Too many links"&; }
	if code == Int(EPIPE) { return "Broken pipe"&; }
	if code == Int(EDOM) { return "Numerical argument out of domain"&; }
	if code == Int(ERANGE) { return "Numerical result out of range"&; }
	if code == Int(EDEADLK) { return "Resource deadlock avoided"&; }
	if code == Int(ENAMETOOLONG) { return "File name too long"&; }
	if code == Int(ENOLCK) { return "No locks available"&; }
	if code == Int(ENOSYS) { return "Function not implemented"&; }
	if code == Int(ENOTEMPTY) { return "Directory not empty"&; }
	if code == Int(ELOOP) { return "Too many levels of symbolic links"&; }
	if code == Int(ENOMSG) { return "No message of desired type"&; }
	if code == Int(EIDRM) { return "Identifier removed"&; }
	if code == Int(ECHRNG) { return "Channel number out of range"&; }
	if code == Int(EL2NSYNC) { return "Level 2 not synchronized"&; }
	if code == Int(EL3HLT) { return "Level 3 halted"&; }
	if code == Int(EL3RST) { return "Level 3 reset"&; }
	if code == Int(ELNRNG) { return "Link number out of range"&; }
	if code == Int(EUNATCH) { return "Protocol driver not attached"&; }
	if code == Int(ENOCSI) { return "No CSI structure available"&; }
	if code == Int(EL2HLT) { return "Level 2 halted"&; }
	if code == Int(EBADE) { return "Invalid exchange"&; }
	if code == Int(EBADR) { return "Invalid request descriptor"&; }
	if code == Int(EXFULL) { return "Exchange full"&; }
	if code == Int(ENOANO) { return "No anode"&; }
	if code == Int(EBADRQC) { return "Invalid request code"&; }
	if code == Int(EBADSLT) { return "Invalid slot"&; }
	if code == Int(EBFONT) { return "Bad font file format"&; }
	if code == Int(ENOSTR) { return "Device not a stream"&; }
	if code == Int(ENODATA) { return "No data available"&; }
	if code == Int(ETIME) { return "Timer expired"&; }
	if code == Int(ENOSR) { return "Out of streams resources"&; }
	if code == Int(ENONET) { return "Machine is not on the network"&; }
	if code == Int(ENOPKG) { return "Package not installed"&; }
	if code == Int(EREMOTE) { return "Object is remote"&; }
	if code == Int(ENOLINK) { return "Link has been severed"&; }
	if code == Int(EADV) { return "Advertise error"&; }
	if code == Int(ESRMNT) { return "Srmount error"&; }
	if code == Int(ECOMM) { return "Communication error on send"&; }
	if code == Int(EPROTO) { return "Protocol error"&; }
	if code == Int(EMULTIHOP) { return "Multihop attempted"&; }
	if code == Int(EDOTDOT) { return "RFS specific error"&; }
	if code == Int(EBADMSG) { return "Bad message"&; }

	if code ==
		Int(EOVERFLOW) { return "Value too large for defined data type"&; }

	if code == Int(ENOTUNIQ) { return "Name not unique on network"&; }
	if code == Int(EBADFD) { return "File descriptor in bad state"&; }
	if code == Int(EREMCHG) { return "Remote address changed"&; }

	if code ==
		Int(ELIBACC) { return "Can not access a needed shared library"&; }

	if code == Int(ELIBBAD) { return "Accessing a corrupted shared library"&; }
	if code == Int(ELIBSCN) { return ".lib section in a.out corrupted"&; }

	if code == Int(ELIBMAX) {
		return "Attempting to link in too many shared libraries"&;
	}

	if code ==
		Int(ELIBEXEC) { return "Cannot exec a shared library directly"&; }

	if code == Int(EILSEQ) {
		return "Invalid or incomplete multibyte or wide character"&;
	}

	if code == Int(ERESTART) {
		return "Interrupted system call should be restarted"&;
	}

	if code == Int(ESTRPIPE) { return "Streams pipe error"&; }
	if code == Int(EUSERS) { return "Too many users"&; }
	if code == Int(ENOTSOCK) { return "Socket operation on non-socket"&; }
	if code == Int(EDESTADDRREQ) { return "Destination address required"&; }
	if code == Int(EMSGSIZE) { return "Message too long"&; }
	if code == Int(EPROTOTYPE) { return "Protocol wrong type for socket"&; }
	if code == Int(ENOPROTOOPT) { return "Protocol not available"&; }
	if code == Int(EPROTONOSUPPORT) { return "Protocol not supported"&; }
	if code == Int(ESOCKTNOSUPPORT) { return "Socket type not supported"&; }
	if code == Int(EOPNOTSUPP) { return "Operation not supported"&; }
	if code == Int(EPFNOSUPPORT) { return "Protocol family not supported"&; }

	if code == Int(EAFNOSUPPORT) {
		return "Address family not supported by protocol"&;
	}

	if code == Int(EADDRINUSE) { return "Address already in use"&; }
	if code == Int(EADDRNOTAVAIL) { return "Cannot assign requested address"&; }
	if code == Int(ENETDOWN) { return "Network is down"&; }
	if code == Int(ENETUNREACH) { return "Network is unreachable"&; }
	if code == Int(ENETRESET) { return "Network dropped connection on reset"&; }
	if code == Int(ECONNABORTED) { return "Software caused connection abort"&; }
	if code == Int(ECONNRESET) { return "Connection reset by peer"&; }
	if code == Int(ENOBUFS) { return "No buffer space available"&; }

	if code ==
		Int(EISCONN) { return "Transport endpoint is already connected"&; }

	if code == Int(ENOTCONN) { return "Transport endpoint is not connected"&; }

	if code == Int(ESHUTDOWN) {
		return "Cannot send after transport endpoint shutdown"&;
	}

	if code ==
		Int(ETOOMANYREFS) { return "Too many references: cannot splice"&; }

	if code == Int(ETIMEDOUT) { return "Connection timed out"&; }
	if code == Int(ECONNREFUSED) { return "Connection refused"&; }
	if code == Int(EHOSTDOWN) { return "Host is down"&; }
	if code == Int(EHOSTUNREACH) { return "No route to host"&; }
	if code == Int(EALREADY) { return "Operation already in progress"&; }
	if code == Int(EINPROGRESS) { return "Operation now in progress"&; }
	if code == Int(ESTALE) { return "Stale file handle"&; }
	if code == Int(EUCLEAN) { return "Structure needs cleaning"&; }
	if code == Int(ENOTNAM) { return "Not a XENIX named type file"&; }
	if code == Int(ENAVAIL) { return "No XENIX semaphores available"&; }
	if code == Int(EISNAM) { return "Is a named type file"&; }
	if code == Int(EREMOTEIO) { return "Remote I/O error"&; }
	if code == Int(EDQUOT) { return "Disk quota exceeded"&; }
	if code == Int(ENOMEDIUM) { return "No medium found"&; }
	if code == Int(EMEDIUMTYPE) { return "Wrong medium type"&; }
	if code == Int(ECANCELED) { return "Operation canceled"&; }
	if code == Int(ENOKEY) { return "Required key not available"&; }
	if code == Int(EKEYEXPIRED) { return "Key has expired"&; }
	if code == Int(EKEYREVOKED) { return "Key has been revoked"&; }
	if code == Int(EKEYREJECTED) { return "Key was rejected by service"&; }
	if code == Int(EOWNERDEAD) { return "Owner died"&; }
	if code == Int(ENOTRECOVERABLE) { return "State not recoverable"&; }
	if code == Int(ERFKILL) { return "Operation not possible due to RF-kill"&; }
	if code == Int(EHWPOISON) { return "Memory page has hardware error"&; }
	"Unknown error"&
}

/// Throws an exception containing `operation`, the Linux error message, and
/// errno when `result` is a negative raw syscall result.
pub fn check_syscall(result: Int64, operation: &[Uint8]) {
	if result >= 0i64 { return; }

	let code = Int(0i64 - result);
	let message = error_message(code);
	let code_text = code.to_string();
	let exception: [Uint8] = operation@ + ": " + message@ + " (os error " +
		code_text@ +
		")";
	throw(exception&);
	return;
}
