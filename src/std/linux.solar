pub const ERFKILL = 132;

/// Linux errno: Memory page has hardware error.
pub const EHWPOISON = 133;

/// Returns the conventional Linux message for a positive errno code.
pub fn error_message(code: Int) -> &[Uint8] {
	if code == EPERM { return "Operation not permitted"&; }
	if code == ENOENT { return "No such file or directory"&; }
	if code == ESRCH { return "No such process"&; }
	if code == EINTR { return "Interrupted system call"&; }
	if code == EIO { return "Input/output error"&; }
	if code == ENXIO { return "No such device or address"&; }
	if code == E2BIG { return "Argument list too long"&; }
	if code == ENOEXEC { return "Exec format error"&; }
	if code == EBADF { return "Bad file descriptor"&; }
	if code == ECHILD { return "No child processes"&; }
	if code == EAGAIN { return "Resource temporarily unavailable"&; }
	if code == ENOMEM { return "Cannot allocate memory"&; }
	if code == EACCES { return "Permission denied"&; }
	if code == EFAULT { return "Bad address"&; }
	if code == ENOTBLK { return "Block device required"&; }
	if code == EBUSY { return "Device or resource busy"&; }
	if code == EEXIST { return "File exists"&; }
	if code == EXDEV { return "Invalid cross-device link"&; }
	if code == ENODEV { return "No such device"&; }
	if code == ENOTDIR { return "Not a directory"&; }
	if code == EISDIR { return "Is a directory"&; }
	if code == EINVAL { return "Invalid argument"&; }
	if code == ENFILE { return "Too many open files in system"&; }
	if code == EMFILE { return "Too many open files"&; }
	if code == ENOTTY { return "Inappropriate ioctl for device"&; }
	if code == ETXTBSY { return "Text file busy"&; }
	if code == EFBIG { return "File too large"&; }
	if code == ENOSPC { return "No space left on device"&; }
	if code == ESPIPE { return "Illegal seek"&; }
	if code == EROFS { return "Read-only file system"&; }
	if code == EMLINK { return "Too many links"&; }
	if code == EPIPE { return "Broken pipe"&; }
	if code == EDOM { return "Numerical argument out of domain"&; }
	if code == ERANGE { return "Numerical result out of range"&; }
	if code == EDEADLK { return "Resource deadlock avoided"&; }
	if code == ENAMETOOLONG { return "File name too long"&; }
	if code == ENOLCK { return "No locks available"&; }
	if code == ENOSYS { return "Function not implemented"&; }
	if code == ENOTEMPTY { return "Directory not empty"&; }
	if code == ELOOP { return "Too many levels of symbolic links"&; }
	if code == ENOMSG { return "No message of desired type"&; }
	if code == EIDRM { return "Identifier removed"&; }
	if code == ECHRNG { return "Channel number out of range"&; }
	if code == EL2NSYNC { return "Level 2 not synchronized"&; }
	if code == EL3HLT { return "Level 3 halted"&; }
	if code == EL3RST { return "Level 3 reset"&; }
	if code == ELNRNG { return "Link number out of range"&; }
	if code == EUNATCH { return "Protocol driver not attached"&; }
	if code == ENOCSI { return "No CSI structure available"&; }
	if code == EL2HLT { return "Level 2 halted"&; }
	if code == EBADE { return "Invalid exchange"&; }
	if code == EBADR { return "Invalid request descriptor"&; }
	if code == EXFULL { return "Exchange full"&; }
	if code == ENOANO { return "No anode"&; }
	if code == EBADRQC { return "Invalid request code"&; }
	if code == EBADSLT { return "Invalid slot"&; }
	if code == EBFONT { return "Bad font file format"&; }
	if code == ENOSTR { return "Device not a stream"&; }
	if code == ENODATA { return "No data available"&; }
	if code == ETIME { return "Timer expired"&; }
	if code == ENOSR { return "Out of streams resources"&; }
	if code == ENONET { return "Machine is not on the network"&; }
	if code == ENOPKG { return "Package not installed"&; }
	if code == EREMOTE { return "Object is remote"&; }
	if code == ENOLINK { return "Link has been severed"&; }
	if code == EADV { return "Advertise error"&; }
	if code == ESRMNT { return "Srmount error"&; }
	if code == ECOMM { return "Communication error on send"&; }
	if code == EPROTO { return "Protocol error"&; }
	if code == EMULTIHOP { return "Multihop attempted"&; }
	if code == EDOTDOT { return "RFS specific error"&; }
	if code == EBADMSG { return "Bad message"&; }
	if code == EOVERFLOW { return "Value too large for defined data type"&; }
	if code == ENOTUNIQ { return "Name not unique on network"&; }
	if code == EBADFD { return "File descriptor in bad state"&; }
	if code == EREMCHG { return "Remote address changed"&; }
	if code == ELIBACC { return "Can not access a needed shared library"&; }
	if code == ELIBBAD { return "Accessing a corrupted shared library"&; }
	if code == ELIBSCN { return ".lib section in a.out corrupted"&; }

	if code == ELIBMAX {
		return "Attempting to link in too many shared libraries"&;
	}

	if code == ELIBEXEC { return "Cannot exec a shared library directly"&; }

	if code == EILSEQ {
		return "Invalid or incomplete multibyte or wide character"&;
	}

	if code ==
		ERESTART { return "Interrupted system call should be restarted"&; }

	if code == ESTRPIPE { return "Streams pipe error"&; }
	if code == EUSERS { return "Too many users"&; }
	if code == ENOTSOCK { return "Socket operation on non-socket"&; }
	if code == EDESTADDRREQ { return "Destination address required"&; }
	if code == EMSGSIZE { return "Message too long"&; }
	if code == EPROTOTYPE { return "Protocol wrong type for socket"&; }
	if code == ENOPROTOOPT { return "Protocol not available"&; }
	if code == EPROTONOSUPPORT { return "Protocol not supported"&; }
	if code == ESOCKTNOSUPPORT { return "Socket type not supported"&; }
	if code == EOPNOTSUPP { return "Operation not supported"&; }
	if code == EPFNOSUPPORT { return "Protocol family not supported"&; }

	if code ==
		EAFNOSUPPORT { return "Address family not supported by protocol"&; }

	if code == EADDRINUSE { return "Address already in use"&; }
	if code == EADDRNOTAVAIL { return "Cannot assign requested address"&; }
	if code == ENETDOWN { return "Network is down"&; }
	if code == ENETUNREACH { return "Network is unreachable"&; }
	if code == ENETRESET { return "Network dropped connection on reset"&; }
	if code == ECONNABORTED { return "Software caused connection abort"&; }
	if code == ECONNRESET { return "Connection reset by peer"&; }
	if code == ENOBUFS { return "No buffer space available"&; }
	if code == EISCONN { return "Transport endpoint is already connected"&; }
	if code == ENOTCONN { return "Transport endpoint is not connected"&; }

	if code == ESHUTDOWN {
		return "Cannot send after transport endpoint shutdown"&;
	}

	if code == ETOOMANYREFS { return "Too many references: cannot splice"&; }
	if code == ETIMEDOUT { return "Connection timed out"&; }
	if code == ECONNREFUSED { return "Connection refused"&; }
	if code == EHOSTDOWN { return "Host is down"&; }
	if code == EHOSTUNREACH { return "No route to host"&; }
	if code == EALREADY { return "Operation already in progress"&; }
	if code == EINPROGRESS { return "Operation now in progress"&; }
	if code == ESTALE { return "Stale file handle"&; }
	if code == EUCLEAN { return "Structure needs cleaning"&; }
	if code == ENOTNAM { return "Not a XENIX named type file"&; }
	if code == ENAVAIL { return "No XENIX semaphores available"&; }
	if code == EISNAM { return "Is a named type file"&; }
	if code == EREMOTEIO { return "Remote I/O error"&; }
	if code == EDQUOT { return "Disk quota exceeded"&; }
	if code == ENOMEDIUM { return "No medium found"&; }
	if code == EMEDIUMTYPE { return "Wrong medium type"&; }
	if code == ECANCELED { return "Operation canceled"&; }
	if code == ENOKEY { return "Required key not available"&; }
	if code == EKEYEXPIRED { return "Key has expired"&; }
	if code == EKEYREVOKED { return "Key has been revoked"&; }
	if code == EKEYREJECTED { return "Key was rejected by service"&; }
	if code == EOWNERDEAD { return "Owner died"&; }
	if code == ENOTRECOVERABLE { return "State not recoverable"&; }
	if code == ERFKILL { return "Operation not possible due to RF-kill"&; }
	if code == EHWPOISON { return "Memory page has hardware error"&; }
	"Unknown error"&
}

/// Throws an exception containing `operation`, the Linux error message, and
/// errno when `result` is a negative raw syscall result.
pub fn check_syscall(result: Int64, operation: &[Uint8]) {
	if result >= 0i64 { return; }

	let code = Int(0i64 - result);
	let message = error_message(code);
	let code_text = code.to_string();
	let exception: [Uint8] = operation@ + ": " + message@ + " (os error " +
		code_text@ +
		")";
	throw(exception&);
	return;
}
