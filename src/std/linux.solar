// File descriptors, open flags, permissions, and locks.

/// The current working directory (-100 encoded as a syscall word).
pub const AT_FDCWD = 18446744073709551516u64;

/// Close the descriptor on exec.
pub const O_CLOEXEC = 0o2000000;

/// Open for reading only.
pub const O_RDONLY = 0;

/// Open for writing only.
pub const O_WRONLY = 1;

/// Open for reading and writing.
pub const O_RDWR = 2;

/// Create the file if it does not exist.
pub const O_CREAT = 64;

/// With O_CREAT, fail if the file already exists.
pub const O_EXCL = 128;

/// Truncate an existing file when opened for writing.
pub const O_TRUNC = 512;

/// Append writes to the end of the file.
pub const O_APPEND = 1024;

/// Require the opened path to be a directory.
pub const O_DIRECTORY = 0o200000;

/// Acquire a shared advisory file lock.
pub const LOCK_SH = 1;

/// Acquire an exclusive advisory file lock.
pub const LOCK_EX = 2;

/// Acquire an advisory file lock without blocking.
pub const LOCK_NB = 4;

/// Release an advisory file lock.
pub const LOCK_UN = 8;

/// Standard input file descriptor.
pub const STDIN_FILENO = 0i32;

/// Standard output file descriptor.
pub const STDOUT_FILENO = 1i32;

/// Standard error file descriptor.
pub const STDERR_FILENO = 2i32;

/// Default file permissions before applying the process umask.
pub const DEFFILEMODE = 0o666u;

/// Read, write, and execute permission bits for all users.
pub const ACCESSPERMS = 0o777u;

// Linux x86-64 file metadata and directory entry layouts.

/// Mask selecting the file type in st_mode.
pub const S_IFMT = 0o170000u32;

/// File type bits for a regular file.
pub const S_IFREG = 0o100000u32;

/// File type bits for a directory.
pub const S_IFDIR = 0o040000u32;

/// Size of the Linux x86-64 stat structure in bytes.
pub const STAT_SIZE = 144u;

/// Byte offset of st_mode in Linux x86-64 stat.
pub const STAT_MODE_OFFSET = 24u;

/// Byte offset of st_size in Linux x86-64 stat.
pub const STAT_SIZE_OFFSET = 48u;

/// Byte offset of st_mtim.tv_sec in Linux x86-64 stat.
pub const STAT_MTIME_SEC_OFFSET = 88u;

/// Byte offset of st_mtim.tv_nsec in Linux x86-64 stat.
pub const STAT_MTIME_NSEC_OFFSET = 96u;

/// Byte offset of d_reclen in Linux linux_dirent64.
pub const DIRENT64_RECLEN_OFFSET = 16u;

/// Byte offset of d_type in Linux linux_dirent64.
pub const DIRENT64_TYPE_OFFSET = 18u;

/// Byte offset of d_name in Linux linux_dirent64.
pub const DIRENT64_NAME_OFFSET = 19u;

/// Directory entry type for a regular file.
pub const DT_REG = 8u8;

/// Directory entry type for a directory.
pub const DT_DIR = 4u8;

// Socket protocols, options, and Linux address layouts.

/// IPv4 socket address family.
pub const AF_INET = 2;

/// IPv6 socket address family.
pub const AF_INET6 = 10;

/// Reliable, connection-oriented byte-stream socket type.
pub const SOCK_STREAM = 1;

/// Socket-level option namespace.
pub const SOL_SOCKET = 1;

/// Allow reuse of local socket addresses.
pub const SO_REUSEADDR = 2;

/// Select the default protocol for the socket type.
pub const IPPROTO_IP = 0;

/// TCP protocol number and socket option level.
pub const IPPROTO_TCP = 6;

/// Disable the TCP Nagle algorithm.
pub const TCP_NODELAY = 1;

/// Disable further reads from a socket.
pub const SHUT_RD = 0;

/// Disable further writes to a socket.
pub const SHUT_WR = 1;

/// Close the socket descriptor on exec.
pub const SOCK_CLOEXEC = 0o2000000;

/// Buffer size sufficient for Linux sockaddr_in and sockaddr_in6.
pub const SOCKADDR_MAX = 28u;

/// Size of Linux sockaddr_in in bytes.
pub const SOCKADDR_IN_SIZE = 16u;

/// Size of Linux sockaddr_in6 in bytes.
pub const SOCKADDR_IN6_SIZE = 28u;

/// Byte offset of the address family in Linux socket addresses.
pub const SOCKADDR_FAMILY_OFFSET = 0u;

/// Byte offset of the network-order port in sockaddr_in and sockaddr_in6.
pub const SOCKADDR_PORT_OFFSET = 2u;

/// Byte offset of sin_addr in Linux sockaddr_in.
pub const SOCKADDR_IN_ADDR_OFFSET = 4u;

/// Byte offset of sin6_addr in Linux sockaddr_in6.
pub const SOCKADDR_IN6_ADDR_OFFSET = 8u;

/// Exclusive end byte offset of sin6_addr in Linux sockaddr_in6.
pub const SOCKADDR_IN6_ADDR_END = 24u;

/// Size in bytes of an integer Linux socket option.
pub const SOCKOPT_INT_SIZE = 4u64;

// Time units used by Linux timestamps and timeouts.

/// Nanoseconds per second in Linux timespec fields.
pub const NSEC_PER_SEC = 1000000000u64;

// Futex operations.

/// Process-private futex wait operation.
pub const FUTEX_WAIT_PRIVATE = 128i64;

/// Process-private futex wake operation.
pub const FUTEX_WAKE_PRIVATE = 129i64;

/// Maximum signed Linux futex wake count, used to wake all waiters.
pub const FUTEX_WAKE_ALL = 2147483647u32;

// Defaults used by Solar's Linux wrappers.

/// Default maximum number of pending connections in a TCP listener's queue.
pub const TCP_LISTEN_BACKLOG = 128;

/// Buffer size in bytes for each getdents64 batch.
pub const GETDENTS_BUFFER_SIZE = 32768u;

/// Solar futex timeout sentinel requesting an indefinite wait.
pub const FUTEX_NO_TIMEOUT = 18446744073709551615u64;

