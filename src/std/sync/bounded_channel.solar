import {VecDeque, throw} from "../lib.solar";
import {Condvar} from "condvar.solar";

/// A bounded FIFO channel for multiple producers and consumers.
/// Share a reference between threads. A value copy has its own queue and limit.
pub struct BoundedChannel#[T] { inner: Condvar#[VecDeque#[T]], capacity: Uint }

/// Creates an empty channel with room for `capacity` values. Capacity must be positive.
pub fn BoundedChannel::#[out T](capacity: Uint) -> BoundedChannel#[T] {
	if capacity == 0u { throw("BoundedChannel: capacity must be positive"&); }
	BoundedChannel#[T] {
		inner: Condvar(VecDeque#[T]::with_capacity(capacity)),
		capacity: capacity,
	}
}

/// Enqueues a value, waiting while the channel is full.
pub method send#[T](self: &BoundedChannel#[T], value: T) {
	let condition = self@.inner&;
	condition.with_lock(\queue, waiter {
		while queue.len() == self@.capacity { waiter.wait(); }
		queue.push_back(value);
		// All receivers waiting on the empty queue can now recheck it.
		if queue.len() == 1u { condition.notify_all(); }
	});
}

/// Dequeues the oldest value, waiting while the channel is empty.
pub method recv#[T](self: &BoundedChannel#[T]) -> T {
	let condition = self@.inner&;
	condition.with_lock(\queue, waiter {
		while queue.is_empty() { waiter.wait(); }
		// Senders can recheck for space once we release the lock.
		if queue.len() == self@.capacity { condition.notify_all(); }
		queue.pop_front().unwrap()
	})
}
