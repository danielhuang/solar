import {Option, Ordering, throw} from "lib.solar";
import {Vec} from "vec.solar";

/// An iterator that transforms each inner value with a callback.
pub struct Map#[I, T, U] { inner: I, f: fn(T) -> U }

/// An iterator that yields only values accepted by a predicate.
pub struct Filter#[I, T] { inner: I, predicate: fn(T) -> Bool }

/// Lazily transforms each value yielded by the iterator.
pub method map#[I, T, U](self: I, f: fn(T) -> U) -> Map#[I, T, U] {
	Map#[I, T, U] { inner: self, f: f }
}

/// Advances the inner iterator and transforms its next value, if present.
pub method next#[I, T, U](self: &Map#[I, T, U]) -> Option#[U] {
	match self@.inner&.next() {
		Option#[T]::Some(value) => Option#[U]::Some((self@.f)(value)),
		Option#[T]::None => Option#[U]::None,
	}
}

/// Lazily yields only values for which the predicate returns true.
pub method filter#[I, T](self: I, predicate: fn(T) -> Bool) -> Filter#[I, T] {
	Filter#[I, T] { inner: self, predicate: predicate }
}

/// Advances until a value passes the predicate or the inner iterator ends.
pub method next#[I, T](self: &Filter#[I, T]) -> Option#[T] {
	while true {
		match self@.inner&.next() {
			Option#[T]::Some(value) => {
				if (self@.predicate)(value) {
					return Option#[T]::Some(value);
				}
			},
			Option#[T]::None => { break; },
		};
	}

	Option#[T]::None
}

/// Copies the iterator's current cursor for a for-in loop.
pub method iter#[I](self: &I) -> I { self@ }

/// An iterator containing at most one value.
pub struct Once#[T] { value: Option#[T] }

/// Creates an iterator yielding one value.
pub fn once#[T](value: T) -> Once#[T] {
	Once#[T] { value: Option#[T]::Some(value) }
}

/// Advances a single-value iterator.
pub method next#[T](self: &Once#[T]) -> Option#[T] {
	let value = self@.value;
	self@.value = Option#[T]::None;
	value
}

/// Advances a single-value iterator from the back.
pub method next_back#[T](self: &Once#[T]) -> Option#[T] {
	self.next()
}

/// Returns the number of remaining values.
pub method len#[T](self: &Once#[T]) -> Uint {
	if self@.value.is_some() { 1u } else { 0u }
}

/// An iterator driven by a callback.
pub struct FromFn#[T] { f: fn() -> Option#[T] }

/// Calls `f` for each next value. A None does not permanently exhaust this iterator.
pub fn from_fn#[T](f: fn() -> Option#[T]) -> FromFn#[T] {
	FromFn#[T] { f: f }
}

/// Invokes the iterator's callback.
pub method next#[T](self: &FromFn#[T]) -> Option#[T] {
	(self@.f)()
}

/// An iterator copying values behind references.
pub struct Copied#[I] { source: I }

/// Lazily copies referenced items using Solar's value-copy semantics.
pub method copied#[I](self: I) -> Copied#[I] {
	Copied#[I] { source: self }
}

/// Copies the next referenced item.
pub method next#[I](self: &Copied#[I]) {
	self@.source&.next().copied()
}

/// Copies the next referenced item from the back.
pub method next_back#[I](self: &Copied#[I]) {
	self@.source&.next_back().copied()
}

/// Returns the number of remaining items when the source has an exact length.
pub method len#[I](self: &Copied#[I]) -> Uint {
	self@.source&.len()
}

/// An iterator pairing each item with its zero-based index.
pub struct Enumerate#[I] { source: I, index: Uint }

/// Lazily pairs each item with its index.
pub method enumerate#[I](self: I) -> Enumerate#[I] {
	Enumerate#[I] { source: self, index: 0u }
}

/// Returns the next index and item.
pub method next#[I](self: &Enumerate#[I]) {
	self@.source&.next().map(\value {
		let index = self@.index;
		self@.index = index + 1u;
		(index, value)
	})
}

/// Returns the last index and item; requires an exact-size source.
pub method next_back#[I](self: &Enumerate#[I]) {
	self@.source&.next_back().map(\value {
		(self@.index + self@.source&.len(), value)
	})
}

/// Returns the remaining exact length.
pub method len#[I](self: &Enumerate#[I]) -> Uint {
	self@.source&.len()
}

/// Reverses a double-ended iterator.
pub struct Rev#[I] { source: I }

/// Lazily traverses a double-ended iterator in reverse.
pub method rev#[I](self: I) -> Rev#[I] {
	Rev#[I] { source: self }
}

/// Advances the source from the back.
pub method next#[I](self: &Rev#[I]) {
	self@.source&.next_back()
}

/// Advances the source from the front.
pub method next_back#[I](self: &Rev#[I]) {
	self@.source&.next()
}

/// Returns the remaining exact length.
pub method len#[I](self: &Rev#[I]) -> Uint {
	self@.source&.len()
}

/// Maps values from the back of a double-ended iterator.
pub method next_back#[I, T, U](self: &Map#[I, T, U]) -> Option#[U] {
	self@.inner&.next_back().map(self@.f)
}

/// Returns the remaining exact length of a map iterator.
pub method len#[I, T, U](self: &Map#[I, T, U]) -> Uint {
	self@.inner&.len()
}

/// Finds the next accepted item from the back.
pub method next_back#[I, T](self: &Filter#[I, T]) -> Option#[T] {
	let value = self@.inner&.next_back();

	while value.is_some() {
		if (self@.predicate)(value.unwrap()) { return value; }
		value = self@.inner&.next_back();
	}

	value
}

/// An iterator that discards unsuccessful transformations.
pub struct FilterMap#[I, T, U] { source: I, f: fn(T) -> Option#[U] }

/// Lazily transforms each item, retaining only Some results.
pub method filter_map#[I, T, U](self: I, f: fn(T) -> Option#[U]) -> FilterMap#[
	I,
	T,
	U,
] {
	FilterMap#[I, T, U] { source: self, f: f }
}

/// Returns the next successful transformation.
pub method next#[I, T, U](self: &FilterMap#[I, T, U]) -> Option#[U] {
	let item = self@.source&.next();

	while item.is_some() {
		let result = (self@.f)(item.unwrap());
		if result.is_some() { return result; }
		item = self@.source&.next();
	}

	Option#[U]::None
}

/// Returns the next successful transformation from the back.
pub method next_back#[I, T, U](self: &FilterMap#[I, T, U]) -> Option#[U] {
	let item = self@.source&.next_back();

	while item.is_some() {
		let result = (self@.f)(item.unwrap());
		if result.is_some() { return result; }
		item = self@.source&.next_back();
	}

	Option#[U]::None
}

/// A concatenation of two iterators.
pub struct Chain#[I, J] {
	first: I,
	second: J,
	first_done: Bool,
	second_done: Bool,
}

/// Yields all items from the first iterator, then the second.
pub method chain#[I, J](self: I, other: J) -> Chain#[I, J] {
	Chain#[I, J] {
		first: self,
		second: other,
		first_done: false,
		second_done: false,
	}
}

/// Advances a concatenated iterator.
pub method next#[I, J](self: &Chain#[I, J]) {
	if !self@.first_done {
		let value = self@.first&.next();
		if value.is_some() { return value; }
		self@.first_done = true;
	}

	if self@.second_done { return absent(\ self@.second&.next()); }
	self@.second&.next()
}

/// Advances a concatenated iterator from the back.
pub method next_back#[I, J](self: &Chain#[I, J]) {
	if !self@.second_done {
		let value = self@.second&.next_back();
		if value.is_some() { return value; }
		self@.second_done = true;
	}

	if self@.first_done {
		return absent(\ self@.first&.next_back());
	}

	self@.first&.next_back()
}

/// Returns the remaining exact length.
pub method len#[I, J](self: &Chain#[I, J]) -> Uint {
	(if self@.first_done { 0u } else { self@.first&.len() }) +
		(if self@.second_done { 0u } else { self@.second&.len() })
}

/// An iterator pairing corresponding items.
pub struct Zip#[I, J] { first: I, second: J }

/// Pairs corresponding items, ending when either iterator ends.
pub method zip#[I, J](self: I, other: J) -> Zip#[I, J] {
	Zip#[I, J] { first: self, second: other }
}

fn zip_options#[T, U](a: Option#[T], b: Option#[U]) -> Option#[(T, U)] {
	if a.is_none() || b.is_none() { Option#[(T, U)]::None } else {
		Option#[(T, U)]::Some((a.unwrap(), b.unwrap()))
	}
}

fn zip_next#[T, J](first: Option#[T], second: &J) {
	let other = if first.is_some() { second.next() } else {
		absent(\ second.next())
	};
	zip_options(first, other)
}

/// Returns the next pair.
pub method next#[I, J](self: &Zip#[I, J]) {
	zip_next(self@.first&.next(), self@.second&)
}

/// Returns the final pair; requires exact-size double-ended sources.
pub method next_back#[I, J](self: &Zip#[I, J]) {
	while self@.first&.len() > self@.second&.len() {
		self@.first&.next_back();
	}

	while self@.second&.len() > self@.first&.len() {
		self@.second&.next_back();
	}

	zip_options(self@.first&.next_back(), self@.second&.next_back())
}

/// Returns the remaining exact length.
pub method len#[I, J](self: &Zip#[I, J]) -> Uint {
	self@.first&.len().min(self@.second&.len())
}

/// An iterator limited to a prefix.
pub struct Take#[I] { source: I, remaining: Uint }

/// Yields at most `count` items without advancing the source beyond that limit.
pub method take#[I](self: I, count: Uint) -> Take#[I] {
	Take#[I] { source: self, remaining: count }
}

fn absent#[T](witness: fn() -> Option#[T]) -> Option#[T] { Option#[T]::None }

/// Returns the next item in a limited prefix.
pub method next#[I](self: &Take#[I]) {
	if self@.remaining == 0u { return absent(\ self@.source&.next()); }

	self@.remaining = self@.remaining - 1u;
	self@.source&.next()
}

/// Returns the back of the remaining prefix; requires an exact-size source.
pub method next_back#[I](self: &Take#[I]) {
	if self@.remaining == 0u { return absent(\ self@.source&.next()); }

	while self@.source&.len() > self@.remaining {
		self@.source&.next_back();
	}

	self@.remaining = self@.remaining - 1u;
	self@.source&.next_back()
}

/// Returns the remaining exact length.
pub method len#[I](self: &Take#[I]) -> Uint {
	self@.source&.len().min(self@.remaining)
}

/// An iterator omitting an initial prefix.
pub struct Skip#[I] { source: I, remaining: Uint }

/// Lazily discards the first `count` items.
pub method skip#[I](self: I, count: Uint) -> Skip#[I] {
	Skip#[I] { source: self, remaining: count }
}

/// Advances past the skipped prefix, then returns the next item.
pub method next#[I](self: &Skip#[I]) {
	while self@.remaining != 0u {
		self@.remaining = self@.remaining - 1u;
		let skipped = self@.source&.next();
		if skipped.is_none() { self@.remaining = 0u; return skipped; }
	}

	self@.source&.next()
}

/// Advances from the back without entering the skipped prefix.
pub method next_back#[I](self: &Skip#[I]) {
	if self@.source&.len() <= self@.remaining {
		return absent(\ self@.source&.next());
	}

	self@.source&.next_back()
}

/// Returns the remaining exact length.
pub method len#[I](self: &Skip#[I]) -> Uint {
	self@.source&.len().saturating_sub(self@.remaining)
}

/// An iterator ending at the first rejected value.
pub struct TakeWhile#[I, T] { source: I, predicate: fn(T) -> Bool, done: Bool }

/// Yields a prefix while a predicate holds; consumes the first rejected item.
pub method take_while#[I, T](self: I, predicate: fn(T) -> Bool) -> TakeWhile#[
	I,
	T,
] {
	TakeWhile#[I, T] { source: self, predicate: predicate, done: false }
}

/// Returns the next accepted item, permanently ending after a rejection.
pub method next#[I, T](self: &TakeWhile#[I, T]) -> Option#[T] {
	if self@.done { return Option#[T]::None; }
	let item = self@.source&.next();
	if item.is_none() { return item; }

	if (self@.predicate)(item.unwrap()) { item } else {
		self@.done = true;
		Option#[T]::None
	}
}

/// An iterator sampling every nth source item.
pub struct StepBy#[I] { source: I, step: Uint, first: Bool }

/// Yields the first item and then every `step`th item; throws for zero.
pub method step_by#[I](self: I, step: Uint) -> StepBy#[I] {
	if step == 0u { throw("step_by: step must be positive"&); }
	StepBy#[I] { source: self, step: step, first: true }
}

/// Returns the next sampled item.
pub method next#[I](self: &StepBy#[I]) {
	let skip = if self@.first { 0u } else { self@.step - 1u };
	self@.first = false;
	self@.source&.nth(skip)
}

/// Returns the next sampled item from the back of an exact-size source.
pub method next_back#[I](self: &StepBy#[I]) {
	let length = self@.source&.len();
	if length == 0u { return absent(\ self@.source&.next()); }
	let skipped = if self@.first { (length - 1u) % self@.step } else {
		length % self@.step
	};
	for i in 0u..skipped { self@.source&.next_back(); }
	self@.source&.next_back()
}

/// Returns the remaining number of samples for an exact-size source.
pub method len#[I](self: &StepBy#[I]) -> Uint {
	let length = self@.source&.len();
	length / self@.step +
		if self@.first && length % self@.step != 0u { 1u } else { 0u }
}

/// An iterator restarting a copy of its original cursor on exhaustion.
pub struct Cycle#[I] { original: I, current: I }

/// Repeats a copyable iterator. An empty source remains empty.
pub method cycle#[I](self: I) -> Cycle#[I] {
	Cycle#[I] { original: self, current: self }
}

/// Returns the next cyclic item.
pub method next#[I](self: &Cycle#[I]) {
	let value = self@.current&.next();
	if value.is_some() { return value; }
	self@.current = self@.original;
	self@.current&.next()
}

/// Advances past `index` items and returns the next one.
pub method nth#[I](self: &I, index: Uint) {
	let n = 0u;

	while n < index {
		let item = self.next();
		if item.is_none() { return item; }
		n = n + 1u;
	}

	self.next()
}

/// Counts the remaining items.
pub method count#[I](self: I) -> Uint {
	let count = 0u;
	while self&.next().is_some() { count = count + 1u; }
	count
}

/// Returns the last item, or None for an empty iterator.
pub method last#[I](self: I) {
	let last = self&.next();
	if last.is_none() { return last; }
	let next = self&.next();
	while next.is_some() { last = next; next = self&.next(); }
	last
}

/// Accumulates items in traversal order, returning `initial` for an empty source.
pub method fold#[I, T, U](self: I, initial: U, f: fn(U, T) -> U) -> U {
	let result = initial;
	let item = self&.next();

	while item.is_some() {
		result = f(result, item.unwrap());
		item = self&.next();
	}

	result
}

/// Reduces items using the first as the accumulator; returns None when empty.
pub method reduce#[I, T](self: I, f: fn(T, T) -> T) -> Option#[T] {
	let first = self&.next();
	if first.is_none() { return first; }
	Option#[T]::Some(self.fold(first.unwrap(), f))
}

/// Sums remaining numeric values, returning the type's default zero when empty.
pub method sum#[I](self: I) {
	let item = self&.next();
	let result = item.unwrap_or_default();

	if item.is_some() {
		item = self&.next();

		while item.is_some() {
			result = result + item.unwrap();
			item = self&.next();
		}
	}

	result
}

fn one_like#[T](witness: Option#[T]) -> T { T(1) }

/// Multiplies remaining numeric values, returning one when empty.
pub method product#[I](self: I) {
	let item = self&.next();
	let result = one_like(item);

	while item.is_some() {
		result = result * item.unwrap();
		item = self&.next();
	}

	result
}

/// Returns whether every remaining item satisfies the predicate, short-circuiting.
pub method all#[I, T](self: I, predicate: fn(T) -> Bool) -> Bool {
	let item = self&.next();

	while item.is_some() {
		if !predicate(item.unwrap()) { return false; }
		item = self&.next();
	}

	true
}

/// Returns whether any remaining item satisfies the predicate, short-circuiting.
pub method any#[I, T](self: I, predicate: fn(T) -> Bool) -> Bool {
	let item = self&.next();

	while item.is_some() {
		if predicate(item.unwrap()) { return true; }
		item = self&.next();
	}

	false
}

/// Returns the first matching item.
pub method find#[I, T](self: I, predicate: fn(T) -> Bool) -> Option#[T] {
	let item = self&.next();

	while item.is_some() {
		if predicate(item.unwrap()) { return item; }
		item = self&.next();
	}

	item
}

/// Returns the first successful transformation.
pub method find_map#[I, T, U](self: I, f: fn(T) -> Option#[U]) -> Option#[U] {
	self.filter_map(f)&.next()
}

/// Returns the index of the first matching item.
pub method position#[I, T](self: I, predicate: fn(T) -> Bool) -> Option#[Uint] {
	let index = 0u;
	let item = self&.next();

	while item.is_some() {
		if predicate(item.unwrap()) { return Option#[Uint]::Some(index); }
		index = index + 1u;
		item = self&.next();
	}

	Option#[Uint]::None
}

/// Returns the smallest item, preferring the first equal item.
pub method min#[I](self: I) {
	let result = self&.next();
	if result.is_none() { return result; }
	let item = self&.next();

	while item.is_some() {
		if item.unwrap().cmp(result.unwrap()) ==
			Ordering::Less { result = item; }

		item = self&.next();
	}

	result
}

/// Returns the largest item, preferring the last equal item.
pub method max#[I](self: I) {
	let result = self&.next();
	if result.is_none() { return result; }
	let item = self&.next();

	while item.is_some() {
		if item.unwrap().cmp(result.unwrap()) !=
			Ordering::Less { result = item; }

		item = self&.next();
	}

	result
}

/// Returns the item with the smallest key; evaluates each key once.
pub method min_by_key#[I, T, K](self: I, key: fn(T) -> K) -> Option#[T] {
	let result = self&.next();
	if result.is_none() { return result; }
	let best = key(result.unwrap());
	let item = self&.next();

	while item.is_some() {
		let current = key(item.unwrap());

		if current.cmp(best) ==
			Ordering::Less { result = item; best = current; }

		item = self&.next();
	}

	result
}

/// Returns the item with the largest key; evaluates each key once, preferring the last tie.
pub method max_by_key#[I, T, K](self: I, key: fn(T) -> K) -> Option#[T] {
	let result = self&.next();
	if result.is_none() { return result; }
	let best = key(result.unwrap());
	let item = self&.next();

	while item.is_some() {
		let current = key(item.unwrap());

		if current.cmp(best) !=
			Ordering::Less { result = item; best = current; }

		item = self&.next();
	}

	result
}

/// Compares two iterators element by element, including their lengths.
pub method eq#[I, J](self: I, other: J) -> Bool {
	let a = self&.next();
	let b = other&.next();

	while a.is_some() && b.is_some() {
		if a.unwrap() != b.unwrap() { return false; }
		a = self&.next();
		b = other&.next();
	}

	a.is_none() && b.is_none()
}

/// Returns whether items are in nondecreasing order.
pub method is_sorted#[I](self: I) -> Bool {
	let previous = self&.next();
	if previous.is_none() { return true; }
	let item = self&.next();

	while item.is_some() {
		if previous.unwrap().cmp(item.unwrap()) ==
			Ordering::Greater { return false; }

		previous = item;
		item = self&.next();
	}

	true
}

/// Collects into a type implementing `Type::from_iter(iterator)`.
/// For example: `source.collect#[vec::Vec#[Int]]()`.
pub method collect#[I, out C](self: I) -> C { C::from_iter(self) }

fn collect_vec_inner#[I, T](source: I, first: Option#[T]) -> Vec#[T] {
	let output = Vec([]#[T]&);
	let item = first;
	while item.is_some() { output&.push(item.unwrap()); item = source&.next(); }
	output
}

/// Collects into a vector, inferring its element type from next().
pub method collect_vec#[I](self: I) {
	let first = self&.next();
	collect_vec_inner(self, first)
}

/// An iterator caching one lookahead result, including None.
pub struct Peekable#[I, T] { source: I, cached: Option#[Option#[T]] }

fn peekable_new#[I, T](source: I, witness: fn() -> Option#[T]) -> Peekable#[
	I,
	T,
] {
	Peekable#[I, T] { source: source, cached: Option#[Option#[T]]::None }
}

/// Adds one-item lookahead without advancing the source during construction.
pub method peekable#[I](self: I) {
	// The uncalled closure supplies the concrete item type without an eager next().
	peekable_new(self, \ self&.next())
}

/// Returns a copy of the cached next item, advancing the source at most once.
pub method peek#[I, T](self: &Peekable#[I, T]) -> Option#[T] {
	if self@.cached.is_none() {
		self@.cached = Option#[Option#[T]]::Some(self@.source&.next());
	}

	self@.cached.unwrap()
}

/// Consumes the lookahead result or advances the source.
pub method next#[I, T](self: &Peekable#[I, T]) -> Option#[T] {
	if self@.cached.is_some() {
		let item = self@.cached.unwrap();
		self@.cached = Option#[Option#[T]]::None;
		return item;
	}

	self@.source&.next()
}

/// Consumes from the back, preserving a front-cached item until it is last.
pub method next_back#[I, T](self: &Peekable#[I, T]) -> Option#[T] {
	if self@.cached.is_some() {
		let cached = self@.cached.unwrap();
		if cached.is_none() { return cached; }
		let item = self@.source&.next_back();
		if item.is_some() { return item; }
		self@.cached = Option#[Option#[T]]::None;
		return cached;
	}

	self@.source&.next_back()
}

/// Returns the remaining exact length, including a cached item.
pub method len#[I, T](self: &Peekable#[I, T]) -> Uint {
	if self@.cached.is_some() {
		if self@.cached.unwrap().is_none() { return 0u; }
		return self@.source&.len() + 1u;
	}

	self@.source&.len()
}

/// A lazy iterator flattening transformed inner iterators from either end.
pub struct FlatMap#[I, T, J] {
	source: I,
	f: fn(T) -> J,
	front: Option#[J],
	back: Option#[J],
	done: Bool,
}

fn flat_map_new#[I, T, J](source: I, f: fn(T) -> J) -> FlatMap#[I, T, J] {
	FlatMap#[I, T, J] {
		source: source,
		f: f,
		front: Option#[J]::None,
		back: Option#[J]::None,
		done: false,
	}
}

/// Maps each item to an iterable and lazily concatenates its iteration items.
pub method flat_map#[I, T, C](self: I, f: fn(T) -> C) {
	flat_map_new(self, \item: T f(item)&.iter())
}

fn flatten_new#[I, T](source: I, witness: fn() -> Option#[T]) {
	source.flat_map(\item: T item)
}

/// Lazily concatenates the items of nested iterables.
pub method flatten#[I](self: I) { flatten_new(self, \ self&.next()) }

/// Returns the next inner item, skipping empty iterables.
pub method next#[I, T, J](self: &FlatMap#[I, T, J]) {
	while true {
		if self@.front.is_some() {
			let current = self@.front.unwrap();
			let item = current&.next();
			self@.front = Option#[J]::Some(current);
			if item.is_some() { return item; }
			self@.front = Option#[J]::None;
		}

		if !self@.done {
			let outer = self@.source&.next();

			if outer.is_some() {
				self@.front = Option#[J]::Some((self@.f)(outer.unwrap()));
				continue;
			}

			self@.done = true;
		}

		if self@.back.is_some() {
			let current = self@.back.unwrap();
			let item = current&.next();
			self@.back = Option#[J]::Some(current);

			if item.is_none() {
				self@.back = Option#[J]::None;
			}

			return item;
		}

		break;
	}

	absent(\ self@.front.unwrap()&.next())
}

/// Returns the next item from the back when both levels are double-ended.
pub method next_back#[I, T, J](self: &FlatMap#[I, T, J]) {
	while true {
		if self@.back.is_some() {
			let current = self@.back.unwrap();
			let item = current&.next_back();
			self@.back = Option#[J]::Some(current);
			if item.is_some() { return item; }
			self@.back = Option#[J]::None;
		}

		if !self@.done {
			let outer = self@.source&.next_back();

			if outer.is_some() {
				self@.back = Option#[J]::Some((self@.f)(outer.unwrap()));
				continue;
			}

			self@.done = true;
		}

		if self@.front.is_some() {
			let current = self@.front.unwrap();
			let item = current&.next_back();
			self@.front = Option#[J]::Some(current);

			if item.is_none() {
				self@.front = Option#[J]::None;
			}

			return item;
		}

		break;
	}

	absent(\ self@.back.unwrap()&.next_back())
}

/// An iterator yielding complete groups of a runtime-selected width.
pub struct ArrayChunks#[I, T] { source: I, width: Uint, done: Bool }

fn chunks_new#[I, T](source: I, width: Uint, witness: fn() -> Option#[T]) -> ArrayChunks#[
	I,
	T,
] {
	ArrayChunks#[I, T] { source: source, width: width, done: false }
}

/// Yields non-overlapping complete groups as slices, discarding a short final group.
/// Solar selects the group width at runtime; zero throws.
pub method array_chunks#[I](self: I, width: Uint) {
	if width == 0u { throw("array_chunks: width must be positive"&); }
	chunks_new(self, width, \ self&.next())
}

/// Collects the next complete group without reading ahead into the following group.
pub method next#[I, T](self: &ArrayChunks#[I, T]) -> Option#[&[T]] {
	if self@.done { return Option#[&[T]]::None; }
	let chunk = Vec([]#[T]&);

	while chunk&.len() < self@.width {
		let item = self@.source&.next();

		if item.is_none() {
			self@.done = true;
			return Option#[&[T]]::None;
		}

		chunk&.push(item.unwrap());
	}

	Option#[&[T]]::Some(chunk&.as_slice())
}

/// Returns the remaining number of complete groups for an exact-size source.
pub method len#[I, T](self: &ArrayChunks#[I, T]) -> Uint {
	if self@.done { 0u } else {
		self@.source&.len() / self@.width
	}
}

/// Returns the final complete group of an exact-size double-ended source.
/// Discards the incomplete suffix before yielding the last complete group.
pub method next_back#[I, T](self: &ArrayChunks#[I, T]) -> Option#[&[T]] {
	if self@.done { return Option#[&[T]]::None; }
	let remainder = self@.source&.len() % self@.width;
	for i in 0u..remainder { self@.source&.next_back(); }

	if self@.source&.len() == 0u {
		self@.done = true;
		return Option#[&[T]]::None;
	}

	let group: [T] = [self@.width; \i: Uint self@.source&.next_back().unwrap()];
	Option#[&[T]]::Some([self@.width; \i: Uint group[self@.width - 1u - i]]&)
}
