import {simd_match_byte_x16, simd_match_high_bit_x16} from "@intrinsics";
import bitmask from "hashbrown/bitmask.solar";
import tag from "hashbrown/tag.solar";

/// Sixteen lanes of `Uint8`.
pub struct SimdUint8x16 {
	/// Vector lanes.
	pub lanes: [Uint8; 16],
}

/// Loads sixteen consecutive lanes.
pub fn u8x16_load(src: &[Uint8], pos: Uint) -> SimdUint8x16 {
	let hi = pos + 16u;
	SimdUint8x16 { lanes: src@[pos..hi] }
}

/// Returns a mask of lanes equal to `v`.
pub method eq_mask(self: SimdUint8x16, v: Uint8) -> Uint {
	simd_match_byte_x16(self.lanes, v)
}

/// Bitmask of the lanes whose high (sign) bit is set (a bare move-mask).
pub method high_bit_mask(self: SimdUint8x16) -> Uint {
	simd_match_high_bit_x16(self.lanes)
}

/// Returns the lanes whose tag is empty.
pub method match_empty(self: SimdUint8x16) -> bitmask::BitMask {
	bitmask::BitMask { mask: self.eq_mask(tag::EMPTY) }
}

/// Returns the lanes whose tag is empty or deleted.
pub method match_empty_or_deleted(self: SimdUint8x16) -> bitmask::BitMask {
	bitmask::BitMask { mask: self.high_bit_mask() }
}

/// Returns the lanes whose tag is full.
pub method match_full(self: SimdUint8x16) -> bitmask::BitMask {
	let eod = self.high_bit_mask();
	let all = (1u << 16u) -- 1u;
	bitmask::BitMask { mask: (!eod) & all }
}
