import {transmute_ref} from "@intrinsics";
import {throw, Ordering} from "lib.solar";
import slice from "slice.solar";
import {Iterator} from "iter.solar";
import {MaybeZeroed} from "mem.solar";
import {Option} from "lib.solar";

/// A growable array.
pub struct Vec#[T] { len: Uint, inner: ^[MaybeZeroed#[T]] }

/// Creates a vector containing a copy of `src`.
pub fn Vec::#[T](src: &[T]) -> Vec#[T] {
	Vec#[T] {
		len: src.len(),
		inner: [src.len(); \i: Uint MaybeZeroed(src@[i])]^,
	}
}

/// Borrows the initialized elements.
pub method as_slice#[T](self: &Vec#[T]) -> &[T] {
	// MaybeZeroed has T's layout, and every element below len is initialized.
	unsafe { transmute_ref#[[T]](self@.inner@&, self@.len) }
}

/// Appends a value.
pub method push#[T](self: &Vec#[T], value: T) {
	let cap = self@.inner@&.len();

	if self@.len >= cap {
		// Round len + 1 up to the next power of two.
		let new_cap = if self@.len == 0u {
			1u
		} else {
			1u << (64u - self@.len.count_leading_zeros())
		};
		// Construct spare slots directly: copying zeroed storage could invoke
		// T's copy constructor on an uninitialized value.
		self@.inner = [new_cap; \i: Uint {
			if i < self@.len {
				MaybeZeroed(unsafe { self@.inner@[i]&.assume_valid()@ })
			} else { MaybeZeroed#[T]() }
		}]^;
	}

	self@.inner@[self@.len]&.write(value);
	self@.len = self@.len + 1u;
}

/// Returns the element at `index`.
pub method at#[T](self: &Vec#[T], index: Uint) -> &T {
	if index >= self@.len {
		throw("Vec.at: index out of bounds"&);
	}

	unsafe { self@.inner@[index]&.assume_valid() }
}

/// Iterates over the vector's elements.
pub method iter#[T](self: &Vec#[T]) -> Iterator#[slice::Iter#[T]] {
	self.as_slice().iter()
}

/// Constructs an empty vector.
pub fn#[T] Vec#[T]::default() -> Vec#[T] { Vec([]#[T]&) }

/// Collects an iterator's values into a new vector.
pub fn#[T] Vec#[T]::from_iter#[I](source: Iterator#[I]) -> Vec#[T] {
	let output = Vec([]#[T]&);
	let item: Option#[T] = source&.next();
	while item.is_some() { output&.push(item.unwrap()); item = source&.next(); }
	output
}

/// Returns the number of initialized vector elements.
pub method len#[T](self: &Vec#[T]) -> Uint { self@.len }

/// Returns whether the vector contains no elements.
pub method is_empty#[T](self: &Vec#[T]) -> Bool { self@.len == 0u }

/// Compares vectors lexicographically using their elements.
pub method cmp#[T](self: &Vec#[T], other: &Vec#[T]) -> Ordering {
	self.as_slice().cmp(other.as_slice())
}

/// Compares vector values lexicographically.
pub method cmp#[T](self: Vec#[T], other: Vec#[T]) -> Ordering {
	self&.cmp(other&)
}
