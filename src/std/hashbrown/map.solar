import {Option} from "../lib.solar";
import raw from "raw.solar";
import tag from "tag.solar";

/// A hash map using deterministic foldhash.
/// Assignment semantics are currently unspecified.
pub struct HashMap#[K, V] { table: raw::RawTable#[K, V] }

/// Creates an empty hash map.
pub fn HashMap::#[out K, out V]() -> HashMap#[K, V] {
	HashMap#[K, V] { table: raw::RawTable#[K, V]() }
}

/// Returns the number of entries.
pub method len#[K, V](self: &HashMap#[K, V]) -> Uint {
	self@.table.items
}

/// Returns whether the map contains no entries.
pub method is_empty#[K, V](self: &HashMap#[K, V]) -> Bool {
	self@.table.items == 0u
}

/// Inserts a key and returns its previous value.
pub method insert#[K, V](self: &HashMap#[K, V], key: K, val: V) -> Option#[V] {
	let t = self@.table&;
	let h = raw::key_hash(key&);
	let location = t.find_or_find_insert(h, key&);
	let result = match location {
		raw::FindInsert::Found(idx) => {
			let s = t@.slots;
			let old = s@[idx].val;
			s@[idx].val = val;
			Option#[V]::Some(old)
		},
		raw::FindInsert::Vacant(slot) => {
			let e = raw::Entry#[K, V] { key: key, val: val };

			if t@.growth_left == 0u {
				let need = t@.items + 1u;
				t.resize(need, e&);
				t.insert_in_slot(h, e);
			} else {
				t.insert_at_slot(h, slot, e);
			}

			Option#[V]::None
		},
	};
	result
}

/// Returns the value for a key.
pub method get#[K, V](self: &HashMap#[K, V], key: &K) -> Option#[&V] {
	let t = self@.table&;
	let h = raw::key_hash(key);
	let result = match t.find(h, key) {
		Option#[Uint]::Some(idx) => {
			let s = t@.slots;
			Option#[&V]::Some(s@[idx].val&)
		},
		Option#[Uint]::None => Option#[&V]::None,
	};
	result
}

/// Returns whether a key is present.
pub method contains_key#[K, V](self: &HashMap#[K, V], key: &K) -> Bool {
	let t = self@.table&;
	let h = raw::key_hash(key);
	let result = match t.find(h, key) {
		Option#[Uint]::Some(idx) => true,
		Option#[Uint]::None => false,
	};
	result
}

/// Returns the value for a key.
pub method get_mut#[K, V](self: &HashMap#[K, V], key: &K) -> Option#[&V] {
	self.get(key)
}

/// Removes a key and returns its value.
pub method remove#[K, V](self: &HashMap#[K, V], key: &K) -> Option#[V] {
	let t = self@.table&;
	let h = raw::key_hash(key);
	let result = match t.find(h, key) {
		Option#[Uint]::Some(idx) => {
			let s = t@.slots;
			let v = s@[idx].val;
			t.erase(idx);
			Option#[V]::Some(v)
		},
		Option#[Uint]::None => Option#[V]::None,
	};
	result
}

/// Removes all entries while retaining capacity.
pub method clear#[K, V](self: &HashMap#[K, V]) {
	let t = self@.table&;
	t.clear();
}

/// Calls `f` for each entry in unspecified order.
pub method for_each#[K, V](self: &HashMap#[K, V], f: fn(&K, &V)) {
	let t = self@.table&;

	if t@.bucket_mask != 0u {
		let buckets = t@.bucket_mask + 1u;
		let s = t@.slots;
		let i = 0u;

		while i < buckets {
			if tag::is_full(t@.ctrl@[i]) {
				f(s@[i].key&, s@[i].val&);
			}

			i = i + 1u;
		}
	}
}

/// A double-ended iterator borrowing a hash table's occupied entries.
/// Do not mutate the map while using this live iterator.
pub struct Iter#[K, V] {
	slots: &[raw::Entry#[K, V]],
	ctrl: &[Uint8],
	front: Uint,
	back: Uint,
	remaining: Uint,
}

/// Iterates over key/value references in unspecified order without allocating.
pub method iter#[K, V](self: &HashMap#[K, V]) -> Iter#[K, V] {
	let table = self@.table&;
	let buckets = if table@.bucket_mask == 0u { 0u } else {
		table@.bucket_mask + 1u
	};
	Iter#[K, V] {
		slots: table@.slots,
		ctrl: table@.ctrl,
		front: 0u,
		back: buckets,
		remaining: table@.items,
	}
}

/// Returns the next occupied entry.
pub method next#[K, V](self: &Iter#[K, V]) -> Option#[(&K, &V)] {
	let state = self;

	while state@.front < state@.back {
		let at = state@.front;
		state@.front = at + 1u;

		if tag::is_full(state@.ctrl@[at]) {
			state@.remaining = state@.remaining - 1u;
			return Option#[(&K, &V)]::Some((
				state@.slots@[at].key&,
				state@.slots@[at].val&,
			));
		}
	}

	Option#[(&K, &V)]::None
}

/// Returns the last remaining occupied entry.
pub method next_back#[K, V](self: &Iter#[K, V]) -> Option#[(&K, &V)] {
	let state = self;

	while state@.front < state@.back {
		state@.back = state@.back - 1u;
		let at = state@.back;

		if tag::is_full(state@.ctrl@[at]) {
			state@.remaining = state@.remaining - 1u;
			return Option#[(&K, &V)]::Some((
				state@.slots@[at].key&,
				state@.slots@[at].val&,
			));
		}
	}

	Option#[(&K, &V)]::None
}

/// Returns the exact number of remaining entries.
pub method len#[K, V](self: &Iter#[K, V]) -> Uint {
	self@.remaining
}

/// Iterates over key references.
pub method keys#[K, V](self: &HashMap#[K, V]) {
	self.iter().map(\entry: (&K, &V) entry.0)
}

/// Iterates over value references.
pub method values#[K, V](self: &HashMap#[K, V]) {
	self.iter().map(\entry: (&K, &V) entry.1)
}

/// Constructs an empty map.
pub fn#[K, V] HashMap#[K, V]::default() -> HashMap#[K, V] { HashMap#[K, V]() }

/// Collects key/value pairs; the last value for a duplicate key wins.
pub fn#[K, V] HashMap#[K, V]::from_iter#[I](source: I) -> HashMap#[K, V] {
	let output = HashMap#[K, V]();
	let item: Option#[(K, V)] = source&.next();

	while item.is_some() {
		let (key, value) = item.unwrap();
		output&.insert(key, value);
		item = source&.next();
	}

	output
}
