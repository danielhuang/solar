/// Formats Int64 in decimal.
pub method to_string(self: Int64) -> &[Uint8] { self.to_radix(10u) }

/// Parses Int64; accepts an optional sign and rejects whitespace and overflow.
pub fn Int64::from_str_radix(text: &[Uint8], radix: Uint) -> Int64 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	let base = Int64(radix);
	let result = 0i64;
	let limit = if negative { (0i64 - 9223372036854775807i64 - 1i64) } else {
		(0i64 - 9223372036854775806i64 - 1i64)
	};

	while at < text.len() {
		let d = Int64(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result < limit / base { throw("parse: integer overflow"&); }
		result = result * base;
		if result < limit + d { throw("parse: integer overflow"&); }
		result = result - d;
		at = at + 1u;
	}

	if negative { result } else { (result - result) - result }
}

/// The default Int is zero.
pub fn Int::default() -> Int { 0 }

/// Subtracts, saturating at the bounds of Int.
pub method saturating_sub(self: Int, rhs: Int) -> Int {
	if rhs > 0 && self < (0 - 9223372036854775807 - 1) + rhs {
		return (0 - 9223372036854775807 - 1);
	}

	if rhs < 0 &&
		self > 9223372036854775807 + rhs { return 9223372036854775807; }

	self - rhs
}

/// Formats Int in radix 2 through 36.
pub method to_radix(self: Int, radix: Uint) -> &[Uint8] {
	let negative = self < 0;
	let magnitude = if negative { Uint64(0 - (self + 1)) + 1u64 } else {
		Uint64(self)
	};
	format_magnitude(magnitude, radix, negative)
}

/// Parses Int; accepts an optional sign and rejects whitespace and overflow.
pub fn Int::from_str_radix(text: &[Uint8], radix: Uint) -> Int {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	let base = Int(radix);
	let result = 0;
	let limit = if negative { (0 - 9223372036854775807 - 1) } else {
		(0 - 9223372036854775806 - 1)
	};

	while at < text.len() {
		let d = Int(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result < limit / base { throw("parse: integer overflow"&); }
		result = result * base;
		if result < limit + d { throw("parse: integer overflow"&); }
		result = result - d;
		at = at + 1u;
	}

	if negative { result } else { (result - result) - result }
}

/// The default Uint8 is zero.
pub fn Uint8::default() -> Uint8 { 0u8 }

/// Subtracts, saturating at the bounds of Uint8.
pub method saturating_sub(self: Uint8, rhs: Uint8) -> Uint8 {
	if self < rhs { 0u8 } else { self - rhs }
}

/// Formats Uint8 in radix 2 through 36.
pub method to_radix(self: Uint8, radix: Uint) -> &[Uint8] {
	format_magnitude(Uint64(self), radix, false)
}

/// Formats Uint8 in decimal.
pub method to_string(self: Uint8) -> &[Uint8] { self.to_radix(10u) }

/// Parses Uint8; accepts an optional sign and rejects whitespace and overflow.
pub fn Uint8::from_str_radix(text: &[Uint8], radix: Uint) -> Uint8 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	if negative { throw("parse: negative unsigned integer"&); }
	let base = Uint8(radix);
	let result = 0u8;

	while at < text.len() {
		let d = Uint8(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result > (255u8 - d) / base { throw("parse: integer overflow"&); }
		result = result * base + d;
		at = at + 1u;
	}

	result
}

/// The default Uint16 is zero.
pub fn Uint16::default() -> Uint16 { 0u16 }

/// Subtracts, saturating at the bounds of Uint16.
pub method saturating_sub(self: Uint16, rhs: Uint16) -> Uint16 {
	if self < rhs { 0u16 } else { self - rhs }
}

/// Formats Uint16 in radix 2 through 36.
pub method to_radix(self: Uint16, radix: Uint) -> &[Uint8] {
	format_magnitude(Uint64(self), radix, false)
}

/// Formats Uint16 in decimal.
pub method to_string(self: Uint16) -> &[Uint8] { self.to_radix(10u) }

/// Parses Uint16; accepts an optional sign and rejects whitespace and overflow.
pub fn Uint16::from_str_radix(text: &[Uint8], radix: Uint) -> Uint16 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	if negative { throw("parse: negative unsigned integer"&); }
	let base = Uint16(radix);
	let result = 0u16;

	while at < text.len() {
		let d = Uint16(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result > (65535u16 - d) / base { throw("parse: integer overflow"&); }
		result = result * base + d;
		at = at + 1u;
	}

	result
}

/// The default Uint32 is zero.
pub fn Uint32::default() -> Uint32 { 0u32 }

/// Subtracts, saturating at the bounds of Uint32.
pub method saturating_sub(self: Uint32, rhs: Uint32) -> Uint32 {
	if self < rhs { 0u32 } else { self - rhs }
}

/// Formats Uint32 in radix 2 through 36.
pub method to_radix(self: Uint32, radix: Uint) -> &[Uint8] {
	format_magnitude(Uint64(self), radix, false)
}

/// Formats Uint32 in decimal.
pub method to_string(self: Uint32) -> &[Uint8] { self.to_radix(10u) }

/// Parses Uint32; accepts an optional sign and rejects whitespace and overflow.
pub fn Uint32::from_str_radix(text: &[Uint8], radix: Uint) -> Uint32 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	if negative { throw("parse: negative unsigned integer"&); }
	let base = Uint32(radix);
	let result = 0u32;

	while at < text.len() {
		let d = Uint32(digit(text@[at], radix).expect("parse: invalid digit"&));

		if result >
			(4294967295u32 - d) / base { throw("parse: integer overflow"&); }

		result = result * base + d;
		at = at + 1u;
	}

	result
}

/// The default Uint64 is zero.
pub fn Uint64::default() -> Uint64 { 0u64 }

/// Subtracts, saturating at the bounds of Uint64.
pub method saturating_sub(self: Uint64, rhs: Uint64) -> Uint64 {
	if self < rhs { 0u64 } else { self - rhs }
}

/// Formats Uint64 in radix 2 through 36.
