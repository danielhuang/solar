	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	let base = Int16(radix);
	let result = 0i16;
	let limit = if negative { (0i16 - 32767i16 - 1i16) } else {
		(0i16 - 32766i16 - 1i16)
	};

	while at < text.len() {
		let d = Int16(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result < limit / base { throw("parse: integer overflow"&); }
		result = result * base;
		if result < limit + d { throw("parse: integer overflow"&); }
		result = result - d;
		at = at + 1u;
	}

	if negative { result } else { (result - result) - result }
