/// Parses Int32; accepts an optional sign and rejects whitespace and overflow.
pub fn Int32::from_str_radix(text: &[Uint8], radix: Uint) -> Int32 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	let base = Int32(radix);
	let result = 0i32;
	let limit = if negative { (0i32 - 2147483647i32 - 1i32) } else {
		(0i32 - 2147483646i32 - 1i32)
	};

	while at < text.len() {
		let d = Int32(digit(text@[at], radix).expect("parse: invalid digit"&));
		if result < limit / base { throw("parse: integer overflow"&); }
		result = result * base;
		if result < limit + d { throw("parse: integer overflow"&); }
		result = result - d;
		at = at + 1u;
	}

	if negative { result } else { (result - result) - result }
}

/// The default Int64 is zero.
pub fn Int64::default() -> Int64 { 0i64 }

/// Subtracts, saturating at the bounds of Int64.
pub method saturating_sub(self: Int64, rhs: Int64) -> Int64 {
	if rhs > 0i64 && self < (0i64 - 9223372036854775807i64 - 1i64) + rhs {
		return (0i64 - 9223372036854775807i64 - 1i64);
	}

	if rhs < 0i64 && self > 9223372036854775807i64 + rhs {
		return 9223372036854775807i64;
	}

	self - rhs
}

/// Formats Int64 in radix 2 through 36.
pub method to_radix(self: Int64, radix: Uint) -> &[Uint8] {
	let negative = self < 0i64;
	let magnitude = if negative { Uint64(0i64 - (self + 1i64)) + 1u64 } else {
		Uint64(self)
