/// Formats Uint64 in decimal.
pub method to_string(self: Uint64) -> &[Uint8] { self.to_radix(10u) }

/// Parses Uint64; accepts an optional sign and rejects whitespace and overflow.
pub fn Uint64::from_str_radix(text: &[Uint8], radix: Uint) -> Uint64 {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	if negative { throw("parse: negative unsigned integer"&); }
	let base = Uint64(radix);
	let result = 0u64;

	while at < text.len() {
		let d = Uint64(digit(text@[at], radix).expect("parse: invalid digit"&));

		if result > (18446744073709551615u64 - d) / base {
			throw("parse: integer overflow"&);
		}

		result = result * base + d;
		at = at + 1u;
	}

	result
}

/// The default Uint is zero.
pub fn Uint::default() -> Uint { 0u }

/// Subtracts, saturating at the bounds of Uint.
pub method saturating_sub(self: Uint, rhs: Uint) -> Uint {
	if self < rhs { 0u } else { self - rhs }
}

/// Formats Uint in radix 2 through 36.
pub method to_radix(self: Uint, radix: Uint) -> &[Uint8] {
	format_magnitude(Uint64(self), radix, false)
}

/// Parses Uint; accepts an optional sign and rejects whitespace and overflow.
pub fn Uint::from_str_radix(text: &[Uint8], radix: Uint) -> Uint {
	if radix < 2u || radix > 36u { throw("radix must be between 2 and 36"&); }
	if text.len() == 0u { throw("parse: empty integer"&); }
	let negative = text@[0u] == '-';
	let at = if negative || text@[0u] == '+' { 1u } else { 0u };
	if at == text.len() { throw("parse: empty integer"&); }
	if negative { throw("parse: negative unsigned integer"&); }
	let base = Uint(radix);
	let result = 0u;

	while at < text.len() {
		let d = Uint(digit(text@[at], radix).expect("parse: invalid digit"&));

		if result > (18446744073709551615u - d) / base {
			throw("parse: integer overflow"&);
		}

		result = result * base + d;
		at = at + 1u;
	}

	result
}
