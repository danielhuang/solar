/// The default Int32 is zero.
pub fn Int32::default() -> Int32 { 0i32 }

/// Subtracts, saturating at the bounds of Int32.
pub method saturating_sub(self: Int32, rhs: Int32) -> Int32 {
	if rhs > 0i32 && self < (0i32 - 2147483647i32 - 1i32) + rhs {
		return (0i32 - 2147483647i32 - 1i32);
	}

	if rhs < 0i32 && self > 2147483647i32 + rhs { return 2147483647i32; }
	self - rhs
}

/// Formats Int32 in radix 2 through 36.
pub method to_radix(self: Int32, radix: Uint) -> &[Uint8] {
	let negative = self < 0i32;
