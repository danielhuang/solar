pub method to_string(self: Int16) -> &[Uint8] { self.to_radix(10u) }

/// Parses Int16; accepts an optional sign and rejects whitespace and overflow.
pub fn Int16::from_str_radix(text: &[Uint8], radix: Uint) -> Int16 {
