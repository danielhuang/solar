import {assert_locked_after_throw} from "lock_exception.solar";

static copies: Int = 0;
struct Counted { value: Int }

fn Counted::(original: &Counted) -> Counted {
	copies = copies + 1;
	Counted { value: original@.value }
}

fn main() {
	let counter = sync::Mutex(0);
	let worker = thread::spawn(\ {
		counter&.with_lock(\value { value@ = value@ + 1; });
	});
	counter&.with_lock(\value { value@ = value@ + 1; });
	worker.join();
	println(counter&.with_lock(\value value@));

	// Copying a mutex copies its value and creates an independent lock.
	let original = sync::Mutex(Counted { value: 7 });
	let before = copies;
	let copied = sync::Mutex(original&);
	assert(copies > before);
	original&.with_lock(\left {
		copied&.with_lock(\right { right@.value = left@.value + 2; });
	});
	assert(original&.with_lock(\value value@.value) == 7);
	assert(copied&.with_lock(\value value@.value) == 9);

	let assigned = original;
	assert(original&.with_lock(\value value@.value) == 7);
	assigned&.with_lock(\value { value@.value = 11; });
	assert(original&.with_lock(\value value@.value) == 7);
	assert(assigned&.with_lock(\value value@.value) == 11);

	let returned = counter&.with_lock(\_ sync::Mutex(42));
	assert(returned&.with_lock(\value value@) == 42);
	assert_locked_after_throw(\f counter&.with_lock(\_ f()));
}
