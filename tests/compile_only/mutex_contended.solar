// Exercises Mutex's contended slow path: many threads hammer a
// shared counter under the lock. A correct lock yields exactly threads*iters;
// any lost update (broken mutual exclusion or a dropped wakeup) shows up as a
// smaller number. Also checks that the lock can be acquired again afterward.
fn main() {
	let counter = sync::Mutex(0);
	let threads = 8u;
	let iters = 20000;

	let handles = ([]#[thread::Thread])^;
	let t = 0u;

	while t < threads {
		let h = thread::spawn(\ {
			let i = 0;

			while i < iters {
				counter&.with_lock(\value { value@ = value@ + 1; });
				i = i + 1;
			}
		});
		handles = (handles@ + [h])^;
		t = t + 1u;
	}

	let j = 0u;

	while j < threads {
		handles@[j].join();
		j = j + 1u;
	}

	println(counter&.with_lock(\value value@)); // 160000
	println(counter&.with_lock(\_ 1)); // 1
}
