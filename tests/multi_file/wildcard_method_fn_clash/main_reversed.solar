// Same as main.solar with the two wildcard imports swapped: neither import
// order may hide the free function behind the same-named method.
import * from "methods.solar";
import * from "funcs.solar";

fn main() {
	println(shared_name(1).to_string());
	let h = Holder { v: 7 };
	println(h&.shared_name().to_string());
}
