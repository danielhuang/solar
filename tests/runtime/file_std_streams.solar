import intrinsics from "@intrinsics";

fn main() {
	assert(intrinsics::fd_to_raw(file::stdin()) == 0i32);
	assert(intrinsics::fd_to_raw(file::stdout()) == 1i32);
	assert(intrinsics::fd_to_raw(file::stderr()) == 2i32);
	let written = unsafe {
		intrinsics::syscall(1i64, 1i64, "stdout\nignored"&, 7u64)
	};
	assert(written == 7i64);
	assert(unsafe { intrinsics::syscall(1i64, 1i64, 0u64, 0u64) } == 0i64);
	assert(file::stdout().write_partial(""&) == 0u);
	println("std streams ok"&);
}
