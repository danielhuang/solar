fn numbers(n: Int) {
	coroutine {
		for i in 0..n { yield i; }
	}
}

fn singleton#[T](value: T) { coroutine { yield value; } }

fn countdown(n: Int) {
	coroutine {
		yield n;

		if n > 0 {
			let child = countdown(n - 1)&;
			for value in child { yield value; }
		}
	}
}

fn countdown_ref(n: Int) {
	coroutine {
		yield n;

		if n > 0 {
			let child = countdown_ref(n - 1);
			for value in child { yield value; }
		}
	}&
}

fn main() {
	let effects = 0;
	let generator = coroutine {
		effects = effects + 1;
		let x = 10;
		let resumed: () = yield x;
		x = x + 1;
		yield x;
		effects = effects + 10;
	};
	assert(effects == 0);
	assert(generator.next().unwrap() == 10);
	assert(effects == 1);
	assert(generator&.next().unwrap() == 11);
	assert(generator.next().is_none());
	assert(effects == 11);
	let shared = coroutine { yield 1; yield 2; };
	let copy = shared;
	assert(shared.next().unwrap() == 1);
	assert(copy.next().unwrap() == 1);
	assert(shared.next().unwrap() == 2);
	assert(copy.next().unwrap() == 2);
	assert(shared.next().is_none());
	assert(copy.next().is_none());
	let locals = coroutine { let n = 5; yield n; n = n + 1; yield n; };
	assert(locals.next().unwrap() == 5);
	let locals_copy = locals;
	assert(locals.next().unwrap() == 6);
	assert(locals_copy.next().unwrap() == 6);

	let g = coroutine (start: Int) {
		let second = yield start;
		let third = yield second + start;
		yield third;
	};
	assert(g.next(10).unwrap() == 10);
	assert(g.next(20).unwrap() == 30);
	assert(g.next(40).unwrap() == 40);
	assert(g.next(99).is_none());
	let nested_yield = coroutine (input: Int) { yield yield input; };
	assert(nested_yield.next(1).unwrap() == 1);
	assert(nested_yield.next(2).unwrap() == 2);
	assert(nested_yield.next(3).is_none());
	let unit_input = coroutine (input: ()) { let resumed: () = yield input; };
	assert(unit_input.next(()).is_some());
	assert(unit_input.next(()).is_none());

	let g = numbers(5);
	let total = 0;
	for n in g { total = total + n; }
	assert(total == 10);
	assert(singleton(7).next().unwrap() == 7);
	assert(singleton(true).next().unwrap());
	let empty = coroutine {};
	assert(empty.next().is_none());
	let recursive = countdown(3);

	for expected in [
		3,
		2,
		1,
		0,
	] { assert(recursive.next().unwrap() == expected@); }

	assert(recursive.next().is_none());
	let recursive = countdown_ref(3);

	for expected in [
		3,
		2,
		1,
		0,
	] { assert(recursive.next().unwrap() == expected@); }

	assert(recursive.next().is_none());
	println("passed"&);
}
