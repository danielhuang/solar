fn completed#[T, R](state: CoroutineState#[T, R]) -> R {
	match state {
		CoroutineState#[T, R]::Yield(value) => throw("expected completion"&),
		CoroutineState#[T, R]::Complete(value) => value,
	}
}

fn closed(call: fn()) {
	let caught = false;

	try { call(); } catch (error) {
		assert(
			error.message@ == "cannot resume a completed or running coroutine",
		);
		caught = true;
	}

	assert(caught);
}

fn forward#[I](inner: I) {
	coroutine {
		let value = 17;
		let __await_value_0 = 18;
		let result = await inner;
		assert(value == 17);
		assert(__await_value_0 == 18);
		result
	}
}

fn source(created: &Int, effects: &Int) {
	created@ = created@ + 1;

	coroutine {
		effects@ = effects@ + 1;
		yield 1;
		effects@ = effects@ + 1;
		yield 2;
		effects@ = effects@ + 1;
		40
	}
}

fn main() {
	let created = 0;
	let effects = 0;
	let parent = coroutine { await source(created&, effects&) + 2 };
	assert(created == 0);
	assert(effects == 0);
	assert(parent.next().unwrap() == 1);
	assert(created == 1);
	assert(effects == 1);
	assert(parent.next().unwrap() == 2);
	assert(effects == 2);
	assert(completed(parent.resume()) == 42);
	assert(created == 1);
	assert(effects == 3);
	closed(\ { parent.next(); });
	closed(\ { parent.resume(); });

	let inner = coroutine { yield 3; 99 };
	let outer = forward(inner);
	assert(outer.next().unwrap() == 3);
	assert(completed(outer.resume()) == 99);
	let empty = forward(coroutine { 37 });
	assert(completed(empty.resume()) == 37);

	let tail = coroutine { await coroutine { yield 4; (42, true) } };
	assert(tail.next().unwrap() == 4);
	assert(completed(tail.resume()) == (42, true));
	let explicit = coroutine { return await coroutine { yield 5; 25 }; };
	assert(explicit.next().unwrap() == 5);
	assert(completed(explicit.resume()) == 25);

	let nested = coroutine {
		await coroutine { await coroutine { yield 6; 33 } } + 9
	};
	assert(nested.next().unwrap() == 6);
	assert(completed(nested.resume()) == 42);
	let repeated = coroutine {
		let total = 0;

		for n in 0..3 {
			total = total + await coroutine { yield n; n + 1 };
		}

		total
	};
	assert(repeated.next().unwrap() == 0);
	assert(repeated.next().unwrap() == 1);
	assert(repeated.next().unwrap() == 2);
	assert(completed(repeated.resume()) == 6);

	let ordinary = coroutine {
		await coroutine { for value in [10, 20] { yield value@; } }
	};
	assert(ordinary.next().unwrap() == 10);
	assert(ordinary.next().unwrap() == 20);
	let unit: () = completed(ordinary.resume());
	let discarded = coroutine { await coroutine { yield 7; 99 }; };
	assert(discarded.next().unwrap() == 7);
	let unit: () = completed(discarded.resume());

	let parameterized = coroutine (input: Int) {
		let result = await coroutine { yield 8; yield 9; 11 };
		result + input
	};
	assert(parameterized.next(1).unwrap() == 8);
	assert(parameterized.next(2).unwrap() == 9);
	assert(completed(parameterized.resume(3)) == 12);

	let recovered = coroutine {
		try {
			await coroutine {
				yield 10;
				if true { throw("inner failure"&); }
				42
			};
		} catch (error) {
			assert(error.message@ == "inner failure");
			yield 11;
		}

		123
	};
	assert(recovered.next().unwrap() == 10);
	assert(recovered.next().unwrap() == 11);
	assert(completed(recovered.resume()) == 123);
	let unit_yield = coroutine { await coroutine { yield (); } };
	let unit: () = unit_yield.next().unwrap();
	let unit: () = completed(unit_yield.resume());

	let infinite = coroutine { await coroutine { loop { yield 12; } } };
	assert(infinite.next().unwrap() == 12);
	assert(infinite.next().unwrap() == 12);

	let reference = coroutine {
		let result = await coroutine { let local = 13; yield 13; local& };
		yield result@;
		result
	};
	assert(reference.next().unwrap() == 13);
	assert(reference.next().unwrap() == 13);
	assert(completed(reference.resume())@ == 13);
	let result_reference = coroutine { (await coroutine { yield 15; 42 })& };
	assert(result_reference.next().unwrap() == 15);
	assert(completed(result_reference.resume())@ == 42);
	let result_references = coroutine {
		for n in 1..3 {
			yield (await coroutine { if false { yield n&; } n })&;
		}
	};
	let first = result_references.next().unwrap();
	let second = result_references.next().unwrap();
	assert(result_references.next().is_none());
	assert(first@ == 1);
	assert(second@ == 2);

	let failing = coroutine {
		await coroutine { yield 14; throw("await failure"&); }
	};
	assert(failing.next().unwrap() == 14);
	let caught = false;

	try { failing.resume(); } catch (error) {
		assert(error.message@ == "await failure");
		caught = true;
	}

	assert(caught);
	closed(\ { failing.resume(); });
	println("passed"&);
}
