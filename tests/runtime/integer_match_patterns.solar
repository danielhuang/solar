fn classify(x: Int) -> Int {
    match x {
        0 => 10,
        2 => 20,
        n => n + 30,
    }
}

fn bump(value: &Int) -> Int {
    value@ = value@ + 1;
    value@
}

fn main() {
    println(classify(0));
    println(classify(2));
    println(classify(7));

    // The match scrutinee must be evaluated exactly once.
    let calls = 0;
    println(classify(bump(calls&)));
    println(calls);
}
