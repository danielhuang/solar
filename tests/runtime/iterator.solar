struct Counter { value: Int }

method next(self: &Counter) -> Option#[Int] {
	if self@.value >= 3 {
		return Option#[Int]::None;
	}

	self@.value = self@.value + 1;
	Option#[Int]::Some(self@.value)
}

fn main() {
	let iterator = Counter { value: 0 };
	assert(iterator&.next() == Option#[Int]::Some(1));
	let copy = iterator;

	assert(iterator&.next() == Option#[Int]::Some(2));
	assert(copy&.next() == Option#[Int]::Some(2));
	assert(iterator&.next() == Option#[Int]::Some(3));
	assert(copy&.next() == Option#[Int]::Some(3));
	assert(copy&.next() == Option#[Int]::None);
	assert(iterator&.next() == Option#[Int]::None);
	assert(iterator&.next() == Option#[Int]::None);

	let source = Counter { value: 0 };
	let mapped: iter::Map#[
		Counter,
		Int,
		Int,
	] = source.map(\value: Int value * 10);
	assert(mapped.filter(\value: Int value > 10).sum() == 50);
	assert(source.collect#[vec::Vec#[Int]]()&.as_slice() == [1, 2, 3]&);
	let total = 0;
	for value in source { total = total + value; }
	assert(total == 6);
	assert(source&.next() == Option#[Int]::Some(1));

	// The Option overload must still infer its callback input despite the
	// blanket iterator adapter also accepting this receiver.
	let option: Option#[Int] = Option#[Int]::Some(4).map(\value value + 1);
	assert(option.unwrap() == 5);
	println("passed"&);
}
