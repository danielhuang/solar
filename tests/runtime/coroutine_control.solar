fn bump(value: &Int) -> Int { value@ = value@ + 1; value@ }

fn collect() {
	try { gc::collect_gc(); } catch (e) {
		assert(e.message@ == "collect_gc: GC is disabled");
	}
}

fn expressions() {
	let count = 0;
	let g = coroutine (input: Int) {
		let value = bump(count&) + (yield 1) + bump(count&);
		yield value;
		let value = if (yield 2) == 0 { yield 3; 30 } else { yield 4; 40 };
		yield value;
	};
	assert(g.next(0).unwrap() == 1);
	assert(count == 1);
	assert(g.next(10).unwrap() == 13);
	assert(count == 2);
	assert(g.next(0).unwrap() == 2);
	assert(g.next(0).unwrap() == 3);
	assert(g.next(0).unwrap() == 30);
	assert(g.next(0).is_none());

	let flags = coroutine (input: Bool) {
		let first = false && (yield false);
		let second = true || (yield false);
		let third = true && (yield true);
		yield first || second && third;
	};
	assert(flags.next(false).unwrap());
	assert(flags.next(true).unwrap());
	assert(flags.next(false).is_none());
}

fn control_flow() {
	let g = coroutine {
		let i = 0;

		while i < 5 {
			i = i + 1;
			if i == 2 { continue; }
			if i == 4 { break; }
			yield i;
		}

		let result = loop {
			yield 10;
			break 20;
		};
		yield result;
		return;
		yield 999;
	};
	for expected in [1, 3, 10, 20] { assert(g.next().unwrap() == expected@); }
	assert(g.next().is_none());

	let g = coroutine {
		let value = Option#[Int]::Some(10);
		let output = match value {
			Option#[Int]::Some(n) => { yield n; n = 20; n + 1 },
			Option#[Int]::None => 0,
		};
		yield output;
		yield value.unwrap();
		yield match 3 { 2 => 0, n => { yield n; n + 1 } };
	};

	for expected in [
		10,
		21,
		20,
		3,
		4,
	] { assert(g.next().unwrap() == expected@); }

	assert(g.next().is_none());
}

fn local_dispatch() {
	let i = 0;
	let g = coroutine {
		while i < 30 {
			if i % 10 == 0 { yield i; }
			i = i + 1;
		}
	};
	assert(g.next().unwrap() == 0);
	i = 19;
	assert(g.next().unwrap() == 20);
	i = 29;
	assert(g.next().is_none());
	assert(i == 30);
	assert(g.next().is_none());

	let callback = \ {};
	let reentrant = coroutine {
		callback();
		yield 1;
		callback();
		yield 2;
	};
	callback = \ { assert(reentrant.next().is_none()); };
	assert(reentrant.next().unwrap() == 1);
	assert(reentrant.next().unwrap() == 2);
	assert(reentrant.next().is_none());
}

fn captures() {
	let outer = 10;
	let make = \ { coroutine { yield outer; outer = outer + 1; yield outer; } };
	let g = make();
	outer = 20;
	assert(g.next().unwrap() == 20);
	assert(g.next().unwrap() == 21);
	assert(outer == 21);
	assert(g.next().is_none());

	let callbacks = coroutine {
		for i in 0..3 {
			let local = i;
			yield \ { local = local + 10; local };
		}
	};
	let first = callbacks.next().unwrap();
	let second = callbacks.next().unwrap();
	assert(first() == 10);
	assert(second() == 11);
	assert(first() == 20);
	assert(callbacks.next().unwrap()() == 12);
	assert(callbacks.next().is_none());
	collect();
	assert(second() == 21);

	let nested = coroutine {
		let value = 50;
		let inner = coroutine { yield value; value = 60; yield value; };
		yield inner.next().unwrap();
		yield inner.next().unwrap();
		yield value;
	};
	assert(nested.next().unwrap() == 50);
	collect();
	assert(nested.next().unwrap() == 60);
	assert(nested.next().unwrap() == 60);

	let unsized = coroutine {
		let bytes = "hello";
		yield bytes&;
		bytes[0u] = 'H';
		yield bytes&;
	};
	let bytes = unsized.next().unwrap();
	collect();
	assert(unsized.next().unwrap()@ == "Hello");
	assert(bytes@ == "Hello");
	assert(unsized.next().is_none());
	collect();
	assert(bytes@ == "Hello");
}

fn places() {
	let a = [1, 2];
	let b = [3, 4];
	let target = a&;
	let g = coroutine (input: Int) {
		target@[0u] = yield 0;
		yield target@[0u];
	};
	assert(g.next(0).unwrap() == 0);
	target = b&;
	assert(g.next(10).unwrap() == 3);
	assert(a[0u] == 10);
	assert(b[0u] == 3);

	let owned = 1^;
	let g = coroutine (input: Int) {
		owned@ = yield owned@;
		yield owned@;
	};
	assert(g.next(0).unwrap() == 1);
	assert(g.next(42).unwrap() == 42);
	assert(owned@ == 42);
}

fn failures() {
	let g = coroutine {
		yield 1;
		throw("coroutine failed"&);
		yield 2;
	};
	assert(g.next().unwrap() == 1);
	let caught = false;

	try { g.next(); } catch (e) {
		assert(e.message@ == "coroutine failed");
		caught = true;
	}

	assert(caught);
	assert(g.next().is_none());

	let g = coroutine (input: Int) {
		try {
			let resumed = yield input;
			yield resumed;
			throw("caught after resume"&);
		} catch (e) {
			assert(e.message@ == "caught after resume");
			yield 30;
			yield 40;
		}

		yield 50;
	};

	for expected in [10, 10, 30, 40, 50] {
		assert(g.next(10).unwrap() == expected@);
	}

	assert(g.next(10).is_none());

	let g = coroutine {
		for i in 0..4 {
			try {
				if i == 0 { continue; }
				yield i;
				if i == 2 { break; }
			} catch (e) { throw(e); }
		}

		try {
			try { yield 3; throw("nested"&); } catch (e) { yield 4; throw(e); }
		} catch (e) { assert(e.message@ == "nested"); yield 5; }

		try { yield 6; return; } catch (e) { throw(e); }
		yield 999;
	};

	for expected in [
		1,
		2,
		3,
		4,
		5,
		6,
	] { assert(g.next().unwrap() == expected@); }

	assert(g.next().is_none());
}

fn main() {
	expressions();
	control_flow();
	local_dispatch();
	captures();
	places();
	failures();
	println("passed"&);
}
