{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Solar",
  "scopeName": "source.solar",
  "patterns": [
    {
      "name": "comment.line.double-slash.solar",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.solar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.solar",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.solar",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.solar",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.float.solar",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:f32|f64|f)\\b"
    },
    {
      "name": "constant.numeric.integer.solar",
      "match": "\\b(?:0b[01]+|0o[0-7]+|0x[0-9a-fA-F]+|[0-9]+)(?:i8|i16|i32|i64|u8|u16|u32|u64|u)?\\b"
    },
    {
      "name": "keyword.control.solar",
      "match": "\\b(?:break|catch|const|continue|else|enum|false|fn|for|from|if|import|in|let|loop|match|method|null|pub|reflect|reflect_fields|reflect_fields_pair|reflect_variant|reflect_variant_pair|return|static|struct|true|try|type|unsafe|while)\\b"
    },
    {
      "name": "keyword.operator.solar",
      "match": "(?:->|=>|\\.\\.|==|!=|<=|>=|&&|\\|\\||[=@&^?\\\\!+*/%<>|]|-)"
    }
  ]
}
